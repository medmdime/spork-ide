   }
  },
  {
   "do": "click",
   "label": "New Tag…",
   "role": "AXMenuItem"
  },
  {
   "find": {
    "text": "Create New Tag On 1cf6d449",
    "role": "AXGroup"
   }
  },
  {
   "do": "keys",
   "keys": "v 0 . 9"
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "sh": "test \"$(git rev-parse v0.9)\" = \"$(git rev-parse main~1)\" && echo same",
   "is": "same"
  }
 ]
}
