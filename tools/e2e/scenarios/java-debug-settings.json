{
 "id": "java-debug-settings",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "cmd-,"
  },
  {
   "expect": {
    "windows.1.title": "Settings – fixture"
   },
   "within": 8000
  },
  {
   "do": "ui"
  },
  {
   "do": "click",
   "role": "AXRow",
   "in": "Settings categories",
   "label": "Build, Execution, Deployment"
  },
  {
   "do": "click",
   "role": "AXRow",
   "in": "Settings categories",
   "label": "Debugger"
  },
  {
   "expect": {
    "settings.page": "Build, Execution, Deployment/Debugger"
   },
   "within": 8000
  },
  {
   "find": {
    "label": "Click line number to perform run to cursor",
    "role": "AXCheckBox",
    "value": "1"
   },
   "within": 8000
  },
  {
   "do": "click",
   "role": "AXRow",
   "in": "Settings categories",
   "label": "Data Views"
  },
  {
   "do": "click",
   "role": "AXRow",
   "in": "Settings categories",
   "label": "Java"
  },
  {
   "expect": {
    "settings.page": "Build, Execution, Deployment/Debugger/Data Views/Java"
   },
   "within": 8000
  },
  {
   "find": [
    {
     "label": "Fully qualified names",
     "role": "AXCheckBox",
     "value": "0"
    },
    {
     "label": "Static fields",
     "role": "AXCheckBox",
     "value": "0"
    },
    {
     "label": "Show hex value for primitives",
     "role": "AXCheckBox",
     "value": "0"
    },
    {
     "label": "Enable alternative view for Collections classes",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "Enable 'toString()' object view",
     "role": "AXCheckBox",
     "value": "1"
    }
   ],
   "ordered": true,
   "within": 8000
  },
  {
   "do": "activate",
   "window": "Settings – fixture"
  },
  {
   "wait": 1000
  },
  {
   "shot": "data-views-java",
   "window": "smallest"
  },
  {
   "do": "click",
   "label": "Static fields",
   "role": "AXCheckBox"
  },
  {
   "do": "click",
   "role": "AXRow",
   "in": "Settings categories",
   "label": "HotSwap"
  },
  {
   "expect": {
    "settings.page": "Build, Execution, Deployment/Debugger/HotSwap"
   },
   "within": 8000
  },
  {
   "find": [
    {
     "label": "Build project before reloading classes",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "Suggest HotSwap in the editor when code is modified",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "Always",
     "role": "AXRadioButton",
     "value": "0"
    },
    {
     "label": "Never",
     "role": "AXRadioButton",
     "value": "0"
    },
    {
     "label": "Ask",
     "role": "AXRadioButton",
     "value": "1"
    }
   ],
   "ordered": true,
   "within": 8000
  },
  {
   "wait": 500
  },
  {
   "shot": "hotswap",
   "window": "smallest"
  },
  {
   "do": "click",
   "role": "AXRow",
   "in": "Settings categories",
   "label": "Stepping"
  },
  {
   "expect": {
    "settings.page": "Build, Execution, Deployment/Debugger/Stepping"
   },
   "within": 8000
  },
  {
   "find": [
    {
     "label": "Skip synthetic methods",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "Skip constructors",
     "role": "AXCheckBox",
     "value": "0"
    },
    {
     "label": "Do not step into the classes",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "com.sun.*",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "java.*",
     "role": "AXCheckBox",
     "value": "1"
    },
    {
     "label": "Resume only the current thread",
     "role": "AXCheckBox",
     "value": "0"
    }
   ],
   "ordered": true,
   "within": 8000
  },
  {
   "wait": 500
  },
  {
   "shot": "stepping",
   "window": "smallest"
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "expect": {
    "value": true
   },
   "of": {
    "do": "setting",
    "path": "/spork/debugger/show_static_fields"
   },
   "within": 8000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames.0": "measure:44, Debuggee (com.example)",
    "run.debug.variables": {
     "contains": "counter = 0"
    }
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
