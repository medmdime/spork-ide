{
 "id": "kotlin-test-gradle",
 "fixture": "tests-kotlin-gradle",
 "covers": [],
 "settings": {
  "languages": {
   "Kotlin": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "expect": {
    "java.tool": "Gradle",
    "kotlin.detected": true
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "expect": {
    "java.linked": true,
    "kotlin.server.running": true
   },
   "within": 600000
  },
  {
   "expect": {
    "kotlin.server.busy": false
   },
   "within": 300000
  },
  {
   "do": "open",
   "path": "src/test/kotlin/com/example/GreetingTest.kt"
  },
  {
   "find": {
    "label": "Run test 'GreetingTest'",
    "role": "AXButton"
   },
   "within": 30000
  },
  {
   "wait": 3000
  },
  {
   "do": "click",
   "label": "Run test 'GreetingTest'",
   "role": "AXButton"
  },
  {
   "find": [
    "Run 'GreetingTest'",
    "Debug 'GreetingTest'",
    "Modify Run Configuration\u2026"
   ],
   "ordered": true,
   "within": 10000
  },
  {
   "do": "click",
   "label": "Run 'GreetingTest'"
  },
  {
   "expect": {
    "run.tabs.0.running": false,
    "run.tabs.0.tests.rows": [
     "Test Results failed",
     "  GreetingTest failed",
     "    greets() passed",
     "    greetsAda() failed"
    ],
    "run.tabs.0.tests.status": "1 test failed, 1 passed"
   },
   "within": 300000
  },
  {
   "do": "click",
   "label": "greetsAda()",
   "role": "AXRow"
  },
  {
   "expect": {
    "run.tabs.0.tests.output": {
     "contains": "Expected :Hello, Ada!\nActual   :Hello, world!"
    }
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "Run test 'GreetingTest.greets'",
     "value": "passed"
    },
    {
     "label": "Run test 'GreetingTest.greetsAda'",
     "value": "failed"
    }
   ],
   "within": 5000
  },
  {
   "do": "activate"
  },
  {
   "wait": 1500
  },
  {
   "shot": "gradle"
  }
 ]
}
