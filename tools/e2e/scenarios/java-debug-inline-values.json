{
 "id": "java-debug-inline-values",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames": [
     "measure:44, Debuggee (com.example)",
     "main:21, Debuggee (com.example)"
    ],
    "run.debug.variables": [
     "name = \"Ada\""
    ]
   },
   "within": 20000
  },
  {
   "expect": {
    "editor.inline_values": [
     "43: static int measure(String name) {  name: \"Ada\"",
     "44: counter += name.length();  name: \"Ada\""
    ]
   },
   "within": 10000
  },
  {
   "wait": 1500
  },
  {
   "do": "activate"
  },
  {
   "wait": 300
  },
  {
   "shot": "inline-values"
  },
  {
   "do": "keys",
   "keys": "cmd-alt-r"
  },
  {
   "expect": {
    "run.debug.variables": [
     "name = \"Grace\""
    ],
    "editor.inline_values": [
     "43: static int measure(String name) {  name: \"Grace\"",
     "44: counter += name.length();  name: \"Grace\""
    ]
   },
   "within": 20000
  },
  {
   "wait": 1500
  },
  {
   "do": "activate"
  },
  {
   "wait": 300
  },
  {
   "shot": "inline-values-changed"
  },
  {
   "do": "keys",
   "keys": "cmd-alt-r"
  }
 ]
}
