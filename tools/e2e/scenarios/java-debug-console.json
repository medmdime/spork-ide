{
 "id": "java-debug-console",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\", \"args\": [\"--ask\"]}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Running"
   },
   "within": 60000
  },
  {
   "do": "click",
   "label": "Console",
   "role": "AXRadioButton"
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "Connected to the target VM, address: 'localhost:"
    }
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "not a number\nName?"
    }
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "Console",
   "role": "AXRadioButton"
  },
  {
   "expect": {
    "focused": [
     "Workspace",
     "Dock",
     "DebugPanel",
     "Terminal"
    ]
   },
   "within": 5000
  },
  {
   "do": "activate"
  },
  {
   "do": "front"
  },
  {
   "expect": {
    "framed": true
   },
   "of": {
    "do": "framed"
   },
   "within": 10000
  },
  {
   "wait": 300
  },
  {
   "do": "type",
   "text": "Ada"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "Hello, Ada!"
    }
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "Disconnected from the target VM, address: 'localhost:"
    }
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "\n\nProcess finished with exit code 0"
    }
   },
   "within": 20000
  }
 ]
}
