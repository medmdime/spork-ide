{
 "id": "search-everywhere-code",
 "covers": [
  "action:GotoClass",
  "dialog:GotoClass",
  "action:GotoSymbol",
  "dialog:GotoSymbol"
 ],
 "reference-app": [
  "screenshots/dialogs/gotosymbol.jpg"
 ],
 "settings": {
  "enable_language_server": true,
  "lsp": {
   "rust-analyzer": {
    "binary": {
     "path": "$RUST_ANALYZER"
    },
    "initialization_options": {
     "checkOnSave": false,
     "cargo": {
      "buildScripts": {
       "enable": false
      }
     },
     "procMacro": {
      "enable": false
     }
    }
   }
  }
 },
 "steps": [
  {
   "file": "src/greeter.rs",
   "text": "pub struct Greeter;\n\nimpl Greeter {\n    pub fn greet(&self) -> String {\n        crate::greeting::hello(\"you\")\n    }\n}\n"
  },
  {
   "file": "src/main.rs",
   "text": "mod greeter;\nmod greeting;\n\nfn main() {\n    println!(\"{}\", greeting::hello(\"world\"));\n}\n"
  },
  {
   "do": "open",
   "path": "src/main.rs"
  },
  {
   "expect": {
    "active": "src/main.rs"
   }
  },
  {
   "do": "keys",
   "keys": "cmd-o"
  },
  {
   "expect": {
    "focused": [
     "Workspace",
     "SearchEverywhere",
     "Input"
    ]
   }
  },
  {
   "find": {
    "label": "Classes",
    "role": "AXRadioButton",
    "value": "1",
    "in": "Search Everywhere"
   }
  },
  {
   "do": "keys",
   "keys": "g r e e"
  },
  {
   "find": {
    "label": "Greeter",
    "role": "AXStaticText",
    "selected": true,
    "in": "Search Everywhere"
   },
   "within": 90000,
   "missing": [
    {
     "label": "greet",
     "role": "AXStaticText"
    },
    {
     "label": "hello",
     "role": "AXStaticText"
    }
   ]
  },
  {
   "wait": 300
  },
  {
   "shot": "classes"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "expect": {
    "active": "src/greeter.rs",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "find": {
    "label": "Line 1, column 12",
    "role": "AXButton"
   }
  },
  {
   "do": "action",
   "name": "navigate::GoToClass"
  },
  {
   "find": {
    "label": "Classes",
    "role": "AXRadioButton",
    "value": "1",
    "in": "Search Everywhere"
   }
  },
  {
   "do": "keys",
   "keys": "escape"
  },
  {
   "do": "keys",
   "keys": "cmd-alt-o"
  },
  {
   "expect": {
    "focused": [
     "Workspace",
     "SearchEverywhere",
     "Input"
    ]
   }
  },
  {
   "find": {
    "label": "Symbols",
    "role": "AXRadioButton",
    "value": "1",
    "in": "Search Everywhere"
   }
  },
  {
   "do": "keys",
   "keys": "h e l l o"
  },
  {
   "find": {
    "label": "hello",
    "role": "AXStaticText",
    "selected": true,
    "in": "Search Everywhere"
   },
   "within": 30000
  },
  {
   "wait": 300
  },
  {
   "shot": "symbols"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "expect": {
    "active": "src/greeting.rs",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "find": {
    "label": "Line 1, column 8",
    "role": "AXButton"
   }
  },
  {
   "do": "action",
   "name": "navigate::GoToSymbol"
  },
  {
   "find": {
    "label": "Symbols",
    "role": "AXRadioButton",
    "value": "1",
    "in": "Search Everywhere"
   }
  },
  {
   "do": "keys",
   "keys": "g r e e t"
  },
  {
   "find": [
    {
     "label": "greet",
     "role": "AXStaticText",
     "in": "Search Everywhere"
    },
    {
     "label": "Greeter",
     "role": "AXStaticText",
     "in": "Search Everywhere"
    }
   ],
   "within": 30000
  },
  {
   "do": "keys",
   "keys": "escape"
  },
  {
   "expect": {
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  }
 ]
}
