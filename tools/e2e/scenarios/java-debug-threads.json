{
 "id": "java-debug-threads",
 "fixture": "maven",
 "covers": [
  "action:Debugger.ShowLibraryFrames"
 ],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "49:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames": [
     "twice:49, Debuggee (com.example)",
     "lambda$1:27, Debuggee (com.example)",
     "2 hidden frames"
    ],
    "run.debug.variables": [
     "value = 13"
    ],
    "run.debug.thread": "\"worker\"@11: STOPPED"
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.threads": {
     "contains": "\"main\"@1: STOPPED"
    }
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "2 hidden frames"
  },
  {
   "expect": {
    "run.debug.frames.0": "twice:49, Debuggee (com.example)",
    "run.debug.frames.1": "lambda$1:27, Debuggee (com.example)",
    "run.debug.frames.3": "run:840, Thread (java.lang)"
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "Hide Frames from Libraries",
   "role": "AXButton"
  },
  {
   "expect": {
    "run.debug.frames": [
     "twice:49, Debuggee (com.example)",
     "lambda$1:27, Debuggee (com.example)",
     "2 hidden frames"
    ]
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "cmd-alt-r"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
