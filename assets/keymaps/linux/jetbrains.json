[
  {
    "bindings": {
      "ctrl-alt-s": "zed::OpenSettings",
      "shift-escape": "workspace::CloseActiveDock", // IntelliJ: Hide Active Tool Window, in place of workspace::ToggleZoom
      "ctrl-f2": "run::Stop",
      "f7": "debugger::StepInto",
      "shift-f7": "run::SmartStepInto",
      "alt-shift-f8": "run::ForceStepOver",
      "ctrl-alt-f9": "run::ForceRunToCursor",
      "ctrl-alt-f5": "run::AttachToProcess",
      "ctrl-shift-f2": "run::StopBackgroundProcesses",
      "f8": "debugger::StepOver",
      "shift-f8": "debugger::StepOut",
      "f9": "debugger::Continue",
      "alt-f9": "debugger::RunToCursor",
      "alt-shift-f9": "run::ChooseDebugConfiguration",
      "shift-f10": "run_widget::Run",
      "shift-f9": "run_widget::Debug",
      "alt-f8": "run::EvaluateExpression",
      "ctrl-alt-f8": "run::QuickEvaluateExpression",
      "alt-f10": "run::ShowExecutionPoint",
      "ctrl-shift-f8": "run::ViewBreakpoints",
    },
  },
  {
    // the default keymap's `ctrl-n` (menu::SelectNext) has no context, so this needs none either; the shell keeps it
    "context": "!Terminal",
    "bindings": {
      "ctrl-n": "navigate::GoToClass",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt->": ["zed::IncreaseBufferFontSize", { "persist": true }],
      "alt-<": ["zed::DecreaseBufferFontSize", { "persist": true }],
      "ctrl-insert": "editor::Copy",
      "shift-delete": "editor::Cut",
      "shift-insert": "editor::Paste",
      "alt-backspace": "editor::Undo",
      "alt-shift-backspace": "editor::Redo",
      // IntelliJ shows these first shortcuts in menus: bound again after the secondary keys above, as the latest binding is the one shown
      "ctrl-c": "editor::Copy",
      "ctrl-x": "editor::Cut",
      "ctrl-v": "editor::Paste",
      "ctrl-shift-z": "editor::Redo",
      "ctrl-shift-j": "editor::JoinLines",
      "ctrl-d": "editor::DuplicateSelection",
      "ctrl-y": "editor::DeleteLine",
      "ctrl-m": "editor::ScrollCursorCenter",
      "ctrl-alt-enter": "editor::NewlineAbove",
      "shift-enter": "editor::NewlineBelow",
      "alt-shift-g": "spork_editor::AddCaretsToLineEnds",
      "alt-j": ["editor::SelectNext", { "replace_newest": false }],
      "alt-shift-j": "editor::UndoSelection",
      "ctrl-alt-shift-j": "editor::SelectAllMatches",
      "ctrl-/": ["editor::ToggleComments", { "advance_downwards": true, "comment_empty_lines": true }],
      "ctrl-w": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-w": "editor::SelectSmallerSyntaxNode",
      "shift-alt-up": "editor::MoveLineUp",
      "shift-alt-down": "editor::MoveLineDown",
      // IntelliJ: Clone Caret Above and Below, Ctrl pressed twice and held with the arrow
      "ctrl ctrl-up": ["editor::AddSelectionAbove", { "skip_soft_wrap": true }],
      "ctrl ctrl-down": ["editor::AddSelectionBelow", { "skip_soft_wrap": true }],
      "ctrl-alt-l": "editor::Format",
      "ctrl-alt-o": "editor::OrganizeImports",
      "shift-f6": "editor::Rename",
      "ctrl-alt-left": "pane::GoBack",
      "ctrl-alt-right": "pane::GoForward",
      "alt-f7": "editor::FindAllReferences",
      "ctrl-b": "editor::GoToDefinition", // Conflicts with workspace::ToggleLeftDock
      "ctrl-alt-b": "editor::GoToImplementation", // Conflicts with workspace::ToggleRightDock
      "ctrl-shift-b": "editor::GoToTypeDefinition",
      "f2": "spork_editor::GoToNextError", // IntelliJ: Next Highlighted Error, errors first
      "shift-f2": "spork_editor::GoToPreviousError",
      "ctrl-alt-shift-down": "vcs::ShowNextChangeMarker", // IntelliJ: Next Change, with its popup
      "ctrl-alt-shift-up": "vcs::ShowPrevChangeMarker",
      "ctrl-home": "editor::MoveToBeginning",
      "ctrl-end": "editor::MoveToEnd",
      "ctrl-shift-home": "editor::SelectToBeginning",
      "ctrl-shift-end": "editor::SelectToEnd",
      "ctrl-f8": "editor::ToggleBreakpoint",
      // IntelliJ's run keys, over the default keymap's editing ones
      "f7": "debugger::StepInto", // the default's breakpoint and diagnostics keys otherwise
      "shift-f7": "run::SmartStepInto",
      "alt-shift-f7": "debugger::StepInto",
      "f8": "debugger::StepOver",
      "shift-f8": "debugger::StepOut",
      "alt-shift-f8": "run::ForceStepOver",
      "f9": "debugger::Continue",
      "alt-f9": "debugger::RunToCursor",
      "ctrl-alt-f9": "run::ForceRunToCursor",
      "alt-f8": "run::EvaluateExpression",
      "ctrl-alt-f8": "run::QuickEvaluateExpression",
      "shift-f10": "run_widget::Run",
      "shift-f9": "run_widget::Debug",
      "ctrl-shift-f8": "run::EditBreakpoint", // the Breakpoints dialog without a breakpoint on the line
      "ctrl-shift-u": "editor::ToggleCase",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-f12": "navigate::FileStructure",
      "ctrl-r": ["buffer_search::Deploy", { "replace_enabled": true }],
      "alt-f3": "buffer_search::Deploy",
      "ctrl-e": "navigate::RecentFiles",
      "ctrl-shift-n": "navigate::GoToFile",
      "ctrl-g": "navigate::GoToLine",
      "alt-enter": "editor::ToggleCodeActions",
      "ctrl-space": "editor::ShowCompletions",
      "ctrl-shift-space": "editor::ShowCompletions", // IntelliJ: Type-Matching, the language server's completions
      "ctrl-enter": "spork_editor::SplitLine",
      "ctrl-shift-up": "editor::MoveLineUp", // IntelliJ: Move Statement Up, by lines
      "ctrl-shift-down": "editor::MoveLineDown",
      "ctrl-q": "spork_editor::QuickDocumentation",
      "shift-f1": "editor::OpenDocs",
      "ctrl-p": "editor::ShowSignatureHelp",
      "ctrl-\\": "assistant::InlineAssist",
      "ctrl-alt-h": "call_hierarchy::ShowIncomingCalls",
      "ctrl-alt-z": "git::Restore",
      "ctrl--": "editor::Fold",
      "ctrl-=": "editor::UnfoldLines",
      "ctrl-alt--": "editor::FoldRecursive",
      "ctrl-alt-=": "editor::UnfoldRecursive",
      "ctrl-_": "editor::FoldAll",
      "ctrl-+": "editor::UnfoldAll",
      "ctrl-.": "editor::FoldSelectedRanges",
      "ctrl-shift-.": "editor::Fold", // IntelliJ: Fold Code Block, the innermost region at the caret
      "ctrl-alt-shift-v": "editor::Paste", // IntelliJ: Paste as Plain Text, Zed's paste being plain
      "ctrl-v": "editor::Paste", // shown in menus over Paste as Plain Text
      "ctrl-?": "editor::ToggleBlockComments",
      "ctrl-alt-i": "editor::AutoIndent",
      "alt-up": "editor::GoToPreviousSymbol", // IntelliJ: Previous Method
      "alt-down": "editor::GoToNextSymbol",
      "alt-left": "pane::ActivatePreviousItem",
      "alt-right": "pane::ActivateNextItem",
      "f11": "editor::ToggleBookmark",
      "ctrl-f11": "navigate::ToggleBookmarkMnemonic", // IntelliJ: Toggle Bookmark Mnemonic…, its chooser
      "ctrl-shift-1": ["navigate::ToggleMnemonic", { "mnemonic": "1" }],
      "ctrl-shift-2": ["navigate::ToggleMnemonic", { "mnemonic": "2" }],
      "ctrl-shift-3": ["navigate::ToggleMnemonic", { "mnemonic": "3" }],
      "ctrl-shift-4": ["navigate::ToggleMnemonic", { "mnemonic": "4" }],
      "ctrl-shift-5": ["navigate::ToggleMnemonic", { "mnemonic": "5" }],
      "ctrl-shift-6": ["navigate::ToggleMnemonic", { "mnemonic": "6" }],
      "ctrl-shift-7": ["navigate::ToggleMnemonic", { "mnemonic": "7" }],
      "ctrl-shift-8": ["navigate::ToggleMnemonic", { "mnemonic": "8" }],
      "ctrl-shift-9": ["navigate::ToggleMnemonic", { "mnemonic": "9" }],
      "ctrl-shift-0": ["navigate::ToggleMnemonic", { "mnemonic": "0" }],
      "ctrl-alt-shift-c": "editor::CopyFileLocation", // IntelliJ: Copy Reference
      "ctrl-alt-shift-e": "navigate::GoToText",
      "f3": "search::SelectNextMatch",
      "shift-f3": "search::SelectPreviousMatch",
      "ctrl-l": "search::SelectNextMatch",
      "ctrl-shift-l": "search::SelectPreviousMatch",
      "alt-|": "editor::ShowEditPrediction", // IntelliJ: Call Inline Completion
      "ctrl-shift-m": "spork_editor::MoveToMatchingBrace", // IntelliJ: Move Caret to Matching Brace
      "ctrl-shift-backspace": "navigate::LastEditLocation",
      "ctrl-shift-e": "navigate::RecentLocations",
      "alt-shift-insert": "spork_editor::ToggleColumnMode", // IntelliJ: Column Selection Mode
      "ctrl-[": "spork_editor::MoveToCodeBlockStart",
      "ctrl-]": "spork_editor::MoveToCodeBlockEnd",
      "ctrl-shift-[": "spork_editor::SelectToCodeBlockStart",
      "ctrl-shift-]": "spork_editor::SelectToCodeBlockEnd",
      "ctrl-pageup": "spork_editor::MoveToPageTop",
      "ctrl-pagedown": "spork_editor::MoveToPageBottom",
      "ctrl-shift-pageup": "spork_editor::SelectToPageTop",
      "ctrl-shift-pagedown": "spork_editor::SelectToPageBottom",
      "ctrl-shift-v": "spork_editor::PasteFromHistory",
    },
  },
  {
    // IntelliJ's Column Selection Mode: Shift+Up and Shift+Down grow the block a line
    "context": "Editor && column_mode",
    "bindings": {
      "shift-down": ["editor::AddSelectionBelow", { "skip_soft_wrap": true }],
      "shift-up": ["editor::AddSelectionAbove", { "skip_soft_wrap": true }],
    },
  },
  {
    // Paste from History's chooser: Delete drops a copy
    "context": "PasteChooser",
    "bindings": {
      "delete": "spork_editor::RemoveFromHistory",
      "backspace": "spork_editor::RemoveFromHistory",
    },
  },
  {
    // IntelliJ's Jump to Source (F4) from a list of results
    "context": "Editor && multibuffer",
    "bindings": {
      "f4": "editor::OpenExcerpts",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "enter": "editor::ConfirmCompletionInsert",
      "tab": "editor::ConfirmCompletionReplace",
      "ctrl-.": ["workspace::SendKeystrokes", "enter ."], // IntelliJ: Choose Lookup Item and Insert Dot
    },
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "ctrl-right": "editor::AcceptNextWordEditPrediction",
      "end": "editor::AcceptNextLineEditPrediction",
      "alt-]": "editor::NextEditPrediction",
      "alt-[": "editor::PreviousEditPrediction",
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "bindings": {
      "shift-enter": "editor::Newline",
      "ctrl-shift-enter": "editor::NewlineBelow",
    },
  },
  {
    "context": "BufferSearchBar && !in_replace > Editor",
    "bindings": {
      "shift-enter": "search::SelectPreviousMatch",
    },
  },
  {
    // IntelliJ: Ctrl+R in the find bar shows the replace field
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-r": ["buffer_search::Deploy", { "replace_enabled": true }],
    },
  },
  {
    "context": "AcpThreadSearchBar > Editor",
    "bindings": {
      "shift-enter": "agent::SelectPreviousThreadMatch",
    },
  },
  {
    "context": "BufferSearchBar || ProjectSearchBar",
    "bindings": {
      "alt-c": "search::ToggleCaseSensitive",
      "alt-e": "search::ToggleSelection",
      "alt-x": "search::ToggleRegex",
      "alt-w": "search::ToggleWholeWord",
      "ctrl-alt-e": "search::ToggleSelection",
    },
  },
  {
    "context": "BufferSearchBar > Editor",
    "bindings": {
      "ctrl-alt-e": "search::ToggleSelection", // IntelliJ: Search in Selection Only
    },
