{
 "id": "java-debug-hotswap-restart",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "find": {
    "label": "[Line] [:column]:",
    "role": "AXTextField"
   },
   "within": 5000
  },
  {
   "do": "type",
   "text": "45:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames.0": "measure:45, Debuggee (com.example)",
    "java.hotswap": null
   },
   "within": 20000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "find": {
    "label": "[Line] [:column]:",
    "role": "AXTextField"
   },
   "within": 5000
  },
  {
   "do": "type",
   "text": "50:6"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "type",
   "text": "static int thrice(int value) { return value * 3; }"
  },
  {
   "expect": {
    "java.hotswap": "Restart Debug"
   },
   "within": 10000
  },
  {
   "find": [
    {
     "label": "Hot Swap",
     "role": "AXToolbar"
    },
    {
     "label": "Restart Debug",
     "role": "AXButton"
    },
    {
     "label": "Hide",
     "role": "AXButton"
    }
   ],
   "ordered": true,
   "within": 10000
  },
  {
   "wait": 500
  },
  {
   "do": "activate"
  },
  {
   "wait": 300
  },
  {
   "shot": "restart"
  },
  {
   "do": "click",
   "label": "Restart Debug",
   "role": "AXButton"
  },
  {
   "expect": {
    "run.debug.status": "Stopped",
    "run.debug.frames.0": "measure:45, Debuggee (com.example)"
   },
   "within": 120000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
