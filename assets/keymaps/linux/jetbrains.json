      "ctrl-s": "workspace::SaveAll",
      "ctrl-shift-f12": "workspace::ToggleAllDocks",
      "ctrl-shift-f": "navigate::FindInFiles",
      "ctrl-shift-r": "navigate::ReplaceInFiles",
      "shift shift": "navigate::SearchEverywhere",
      "ctrl-alt-shift-e": "navigate::GoToText", // IntelliJ: Search Everywhere's Text tab
      "alt-shift-f10": "run::ChooseRunConfiguration",
      "ctrl ctrl": "task::Spawn", // IntelliJ: Run Anything
      "ctrl-f5": "task::Rerun",
