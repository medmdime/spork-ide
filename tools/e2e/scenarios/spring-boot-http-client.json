{
 "id": "spring-boot-http-client",
 "fixture": "spring-maven",
 "covers": [],
 "prepare": "cat > requests.http <<'EOF'\n@who = Spork\n\n### Hello\n# @name Hello\nGET http://{{host}}/hello?name={{who}}\nAccept: text/plain\n\n###\nGET http://{{host}}/hello\nEOF\ncat > http-client.env.json <<'EOF'\n{\n  \"dev\": {\n    \"host\": \"localhost:18081\"\n  },\n  \"prod\": {\n    \"host\": \"localhost:1\"\n  }\n}\nEOF",
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   },
   "Spring Boot Properties": {
    "enable_language_server": true
   },
   "Spring Boot YAML": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "expect": {
    "java.tool": "Maven",
    "java.jdk": "17.0.20.1"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 900000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 900000
  },
  {
   "expect": {
    "run.configurations.names": [
     "DemoApplication"
    ]
   },
   "within": 60000
  },
  {
   "expect": {
    "java.spring.classpath": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.spring.index.loaded": true,
    "java.spring.index.endpoints": [
     "GET /hello"
    ]
   },
   "within": 120000
  },
  {
   "do": "keys",
   "keys": "ctrl-r"
  },
  {
   "expect": {
    "run.services.services.DemoApplication.starting": false
   },
   "within": 120000
  },
  {
   "do": "open",
   "path": "requests.http"
  },
  {
   "expect": {
    "active": "requests.http",
    "editor.language": "HTTP Request"
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "Run All Requests in File",
     "role": "AXButton",
     "in": "HTTP Client"
    },
    {
     "label": "Run with:",
     "role": "AXPopUpButton",
     "value": "No Environment"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "find": [
    {
     "label": "Run HTTP Request",
     "role": "AXButton"
    }
   ],
   "within": 5000
  },
  {
   "do": "click",
   "label": "Run with:",
   "role": "AXPopUpButton"
  },
  {
   "menu": "Run with",
   "items": [
    "No Environment",
    "dev",
    "prod"
   ],
   "within": 3000
  },
  {
   "do": "click",
   "label": "dev",
   "role": "AXMenuItem"
  },
  {
   "find": {
    "label": "Run with:",
    "role": "AXPopUpButton",
    "value": "dev"
   },
   "within": 3000
  },
  {
   "do": "action",
   "name": "workspace::CloseAllDocks"
  },
  {
   "do": "activate"
  },
  {
   "wait": 1500
  },
  {
   "shot": "requests"
  },
  {
   "do": "click",
   "label": "Run All Requests in File",
   "role": "AXButton"
  },
  {
   "expect": {
    "http.runs.0.name": "Hello",
    "http.runs.0.status": 200,
    "http.runs.0.text": {
     "contains": "Hello, Spork!"
    },
    "http.runs.1.name": "requests | #2",
    "http.runs.1.text": {
     "contains": "Response code: 200; Time: "
    }
   },
   "within": 20000
  },
  {
   "expect": {
    "docks.bottom.open": true,
    "docks.bottom.panel": "Services",
    "run.services.contributed": "http-request-2"
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "HTTP Request",
     "role": "AXRow"
    },
    {
     "label": "Hello",
     "role": "AXRow"
    },
    {
     "label": "requests | #2",
     "role": "AXRow"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "find": [
    {
     "label": "GET http://localhost:18081/hello",
