{
 "id": "java-project-structure",
 "fixture": "maven",
 "covers": [
  "action:ShowProjectStructureSettings"
 ],
 "steps": [
  {
   "expect": {
    "java.tool": "Maven",
    "java.jdk_name": "zulu-17",
    "java.language_level": "17 - Sealed types, always-strict floating-point semantics"
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "workspace::ClearAllNotifications"
  },
  {
   "do": "keys",
   "keys": "cmd-;"
  },
  {
   "find": [
    {
     "label": "Project",
     "role": "AXRow"
    },
    {
     "label": "Name:",
     "value": "fixture"
    },
    {
     "label": "SDK:",
     "value": "zulu-17"
    },
    {
     "label": "Language level:",
     "value": "17 - Sealed types, always-strict floating-point semantics"
    },
    {
     "label": "Compiler output:",
     "value": "$FIXTURE/out"
    }
   ],
   "within": 10000
  },
  {
   "wait": 1000
  },
  {
   "do": "click",
   "label": "Compiler output:",
   "role": "AXTextField"
  },
  {
   "do": "keys",
   "keys": "cmd-a backspace",
   "window": "Project Structure"
  },
  {
   "do": "type",
   "text": "~/IdeaProjects/fixture/out",
   "window": "Project Structure"
  },
  {
   "find": {
    "label": "Compiler output:",
    "role": "AXTextField",
    "value": "~/IdeaProjects/fixture/out"
   },
   "within": 3000
  },
  {
   "wait": 500
  },
  {
   "shot": "project",
   "window": "smallest"
  },
  {
   "do": "click",
   "label": "Language level:",
   "role": "AXPopUpButton"
  },
  {
   "find": [
    "SDK default",
    "Supported Versions",
    "27 - No new language features",
    "21 - Record patterns, pattern matching for switch",
    "1.3 - Plain old Java",
    "Experimental Versions",
    "X - Experimental features",
    "Unsupported Versions",
    "17 (Preview) - Unsupported"
   ],
   "ordered": true,
   "within": 3000
  },
  {
   "shot": "levels",
   "window": "smallest"
  },
  {
   "do": "click",
   "label": "21 - Record patterns, pattern matching for switch"
  },
  {
   "expect": {
    "java.structure.level": "21 - Record patterns, pattern matching for switch",
    "java.structure.modified": true
   },
   "within": 3000
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "sh": "grep -c '<maven.compiler.release>21</maven.compiler.release>' pom.xml",
   "is": "1"
  },
  {
   "expect": {
    "java.language_level": "21 - Record patterns, pattern matching for switch",
    "java.structure": null
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-;"
  },
  {
   "find": {
    "label": "Language level:",
    "value": "21 - Record patterns, pattern matching for switch"
   },
   "within": 10000
  },
  {
   "do": "click",
   "label": "SDKs"
  },
  {
   "find": [
    {
     "label": "zulu-17",
     "role": "AXRow"
    },
    {
     "label": "Name:",
     "value": "zulu-17"
    },
    {
     "label": "JDK home path:",
     "value": "/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home"
    }
   ],
   "within": 3000
  },
  {
   "wait": 500
  },
  {
   "shot": "sdks",
   "window": "smallest"
  },
  {
   "do": "click",
   "label": "Modules"
  },
  {
   "find": [
    {
     "label": "fixture",
     "role": "AXRow"
    },
    {
     "label": "Language level:",
     "value": "Project default"
    }
   ],
   "within": 3000
  },
  {
   "do": "click",
   "label": "Dependencies",
   "role": "AXRadioButton"
  },
  {
   "find": {
    "label": "Module SDK:",
    "value": "Project SDK"
   },
   "within": 3000
  },
  {
   "wait": 500
  },
  {
   "shot": "modules",
   "window": "smallest"
  }
 ]
}
