{
 "id": "kotlin-coroutine-frames",
 "fixture": "kotlin-coroutines",
 "covers": [],
 "settings": {
  "languages": {
   "Kotlin": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '[{\"label\": \"MainKt\", \"adapter\": \"Kotlin\", \"request\": \"launch\", \"mainClass\": \"com.example.MainKt\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Gradle",
    "kotlin.detected": true
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "expect": {
    "java.linked": true,
    "kotlin.server.running": true
   },
   "within": 600000
  },
  {
   "expect": {
    "kotlin.server.busy": false
   },
   "within": 300000
  },
  {
   "expect": {
    "run.configurations.selected": "MainKt"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/kotlin/com/example/Main.kt"
  },
  {
   "expect": {
    "active": "src/main/kotlin/com/example/Main.kt"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "10:9"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints.0.at": "Main.kt:10"
   },
   "within": 5000
  },
  {
   "find": {
    "label": "Debug 'MainKt'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "docks.bottom.open": true,
    "docks.bottom.panel": "DebugPanel",
    "run.debug.status": "Stopped"
   },
   "within": 180000
  },
  {
   "find": [
    {
     "label": "work:10, MainKt (com.example)",
     "selected": true
    },
    {
     "label": "invokeSuspend:14, MainKt$main$1$doubled$1 (com.example)"
    },
    {
     "label": "Async stack trace"
    },
    {
     "label": "invokeSuspend:14, MainKt$main$1 (com.example)"
    }
   ],
   "ordered": true,
   "within": 20000
  },
  {
   "expect": {
    "run.debug.frames": {
     "contains": "Async stack trace"
    }
   }
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}