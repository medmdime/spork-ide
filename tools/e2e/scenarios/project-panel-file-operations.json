   "find": {
    "label": "fixture",
    "role": "AXRow",
    "in": "Project Panel"
   },
   "within": 8000
  },
  {
   "wait": 400
  },
  {
   "do": "click",
   "label": "fixture",
   "role": "AXRow",
   "in": "Project Panel"
  },
  {
   "wait": 400
  },
  {
   "do": "keys",
   "keys": "cmd-v"
  },
  {
   "find": [
    "Copy",
    "New name:",
    "To directory:"
   ],
   "ordered": true
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "sh": "test -f greeting.rs && test -f src/greeting.rs && echo ok",
