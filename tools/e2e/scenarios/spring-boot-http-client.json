   "within": 10000
  },
  {
   "sh": "cat \"../home/.config/spork-ide/scratches/generated-requests.http\"",
   "contains": "###\nGET http://localhost:18081/hello"
  },
  {
   "do": "action",
   "name": "workspace::CloseAllDocks"
  },
  {
   "do": "click",
   "label": "Run HTTP Request",
   "role": "AXButton"
  },
  {
   "expect": {
    "http.runs.3.name": "generated-requests | #1",
    "http.runs.3.text": {
     "contains": "Hello, world!"
    }
   },
   "within": 20000
  },
  {
   "sh": "grep -c '^<> ' \"../home/.config/spork-ide/scratches/generated-requests.http\"",
   "is": "1",
   "within": 10000
  },
  {
   "do": "action",
   "name": "workspace::CloseAllDocks"
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "find": {
    "label": "src",
    "role": "AXRow",
    "in": "Project Panel"
   },
   "within": 10000
  },
  {
   "do": "click",
   "label": "src",
   "role": "AXRow",
   "button": "right",
   "in": "Project Panel"
  },
  {
   "find": "New",
   "within": 5000
  },
  {
   "do": "click",
   "label": "New",
   "hover": true
  },
  {
   "wait": 600
  },
  {
   "find": [
    "File",
    "Scratch File",
    "Directory",
    "HTTP Request"
   ],
   "ordered": true,
   "within": 8000
  },
  {
   "do": "click",
