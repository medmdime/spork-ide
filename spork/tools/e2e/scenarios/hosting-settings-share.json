{
 "id": "hosting-settings-share",
 "covers": [],
 "reference-app": [],
 "steps": [
  {"do": "action", "name": "spork::ShareOnGitHub"},
  {"within": 6000, "find": [
   {"role": "Heading", "label": "Share Project On GitHub"},
   {"text": "Repository name:"},
   {"role": "AXTextField", "label": "Repository name:", "value": "repo"},
   {"role": "AXCheckBox", "label": "Private", "value": "0"},
   {"text": "Remote:"},
   {"role": "AXTextField", "label": "Remote:", "value": "github"},
   {"text": "Description:"},
   {"text": "Share by:"},
   {"role": "AXLink", "label": "Add account"},
   {"role": "AXButton", "label": "Show help contents"},
   {"role": "AXButton", "label": "Cancel"},
   {"role": "AXButton", "label": "Share"}
  ], "ordered": true},
  {"wait": 300},
  {"shot": "github"},
  {"do": "click", "label": "Share", "role": "AXButton"},
  {"find": [{"text": "Account cannot be empty"}]},
  {"do": "click", "label": "Cancel", "role": "AXButton"},
  {"find": [], "missing": [{"label": "Share Project On GitHub"}]},
  {"git": ["remote"], "is": "origin"},
  {"do": "git", "args": ["remote", "add", "github", "https://github.e2e.invalid/spork/fixture.git"]},
  {"menu": "context-menu:GitHub.MainMenu", "path": ["Git", "GitHub"], "within": 8000, "part": true,
   "items": ["Create Pull Request…", "View Pull Requests"]},
  {"do": "action", "name": "spork::ShareOnGitHub"},
  {"within": 6000, "find": [
   {"role": "Heading", "label": "Project Is Already on GitHub"},
   {"text": "Remote is already on GitHub:"},
   {"role": "AXLink", "label": "https://github.e2e.invalid/spork/fixture.git"},
   {"role": "AXButton", "label": "Cancel"},
   {"role": "AXButton", "label": "Share Anyway"}
  ], "ordered": true},
  {"do": "click", "label": "Share Anyway", "role": "AXButton"},
  {"within": 6000, "find": [{"role": "Heading", "label": "Share Project On GitHub"}],
   "missing": [{"label": "Project Is Already on GitHub"}]},
  {"do": "click", "label": "Cancel", "role": "AXButton"},
  {"do": "action", "name": "spork::ShareOnGitLab"},
  {"within": 6000, "find": [
   {"role": "Heading", "label": "Share Project on GitLab"},
   {"text": "Account:"},
   {"role": "AXPopUpButton", "value": "No accounts"},
   {"role": "AXButton", "label": "Add account"},
   {"text": "Namespace / Group:"},
   {"role": "AXPopUpButton", "value": "No namespaces loaded"},
   {"text": "Repository name:"},
   {"role": "AXTextField", "label": "Repository name:", "value": "repo"},
   {"role": "AXCheckBox", "label": "Private"},
   {"text": "Remote name:"},
   {"role": "AXTextField", "label": "Remote name:", "value": "gitlab"},
   {"text": "Description:"},
   {"role": "AXButton", "label": "Cancel"},
   {"role": "AXButton", "label": "Share"}
  ], "ordered": true},
  {"wait": 300},
  {"shot": "gitlab"},
  {"do": "click", "label": "Share", "role": "AXButton"},
  {"find": [{"text": "No account selected"}]}
 ]
}
