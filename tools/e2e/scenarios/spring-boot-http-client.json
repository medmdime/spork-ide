  {
   "wait": 500
  },
  {
   "do": "keys",
   "keys": "cmd-end"
  },
  {
   "do": "keys",
   "keys": "enter enter"
  },
  {
   "do": "type",
   "text": "###"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "type",
   "text": "PO"
  },
  {
   "expect": {
    "editor.completions": {
     "contains": "POST"
    }
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "escape"
  },
  {
   "do": "type",
   "text": "ST http://localhost:18081/hello"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "type",
   "text": "Acc"
