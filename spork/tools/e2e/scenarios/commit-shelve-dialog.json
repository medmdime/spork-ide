{
 "id": "commit-shelve-dialog",
 "covers": [
  "dialog:ChangesView.Shelve",
  "action:ChangesView.Shelve"
 ],
 "reference-app": [
  "screenshots/dialogs/changesview-shelve.jpg"
 ],
 "steps": [
  {
   "sh": "echo more >> main.rs"
  },
  {
   "do": "action",
   "name": "spork::ToggleCommit"
  },
  {
   "expect": {
    "left": "[Commit, Project]"
   }
  },
  {
   "find": [
    {
     "label": "README.md",
     "role": "AXCheckBox"
    },
    {
     "label": "main.rs",
     "role": "AXCheckBox"
    }
   ],
   "within": 6000
  },
  {
   "wait": 500
  },
  {
   "do": "click",
   "label": "README.md",
   "button": "right"
  },
  {
   "wait": 500
  },
  {
   "find": [
    {
     "label": "Shelve Changes…",
     "role": "AXMenuItem"
    }
   ]
  },
  {
   "do": "click",
   "label": "Shelve Changes…",
   "role": "AXMenuItem"
  },
  {
   "toolbar": "Dialog Changes Toolbar",
   "items": [
    "Show Diff",
    "Rollback…",
    "Refresh",
    "View Options ▸",
    "Expand All",
    "Collapse All"
   ]
  },
  {
   "find": [
    {
     "label": "Changelist:",
     "in": "Shelve Changes"
    },
    {
     "role": "AXPopUpButton",
     "value": "Changes",
     "enabled": false,
     "in": "Shelve Changes"
    },
    {
     "label": "2 files",
     "role": "AXRow",
     "in": "Shelve Changes"
    },
    {
     "label": "README.md",
     "role": "AXCheckBox",
     "value": "1",
     "in": "Shelve Changes"
    },
    {
     "label": "main.rs",
     "role": "AXCheckBox",
     "value": "0",
     "in": "Shelve Changes"
    },
    {
     "label": "1 modified",
     "in": "Shelve Changes"
    },
    {
     "label": "Commit Message",
     "in": "Shelve Changes"
    },
    {
     "label": "Commit Message History",
     "role": "AXButton",
     "in": "Shelve Changes"
    },
    {
     "role": "AXTextArea",
     "in": "Shelve Changes"
    },
    {
     "label": "Diff",
     "role": "AXButton",
     "in": "Shelve Changes"
    },
    {
     "label": "Cancel",
     "role": "AXButton"
    },
    {
     "label": "Shelve Changes",
     "role": "AXButton"
    }
   ],
   "within": 5000
  },
  {
   "do": "click",
   "label": "main.rs",
   "role": "AXCheckBox",
   "in": "Shelve Changes"
  },
  {
   "find": [
    {
     "label": "main.rs",
     "role": "AXCheckBox",
     "value": "1",
     "in": "Shelve Changes"
    },
    {
     "label": "2 modified",
     "in": "Shelve Changes"
    }
   ]
  },
  {
   "do": "click",
   "label": "main.rs",
   "role": "AXCheckBox",
   "in": "Shelve Changes"
  },
  {
   "do": "click",
   "role": "AXTextArea",
   "in": "Shelve Changes"
  },
  {
   "do": "keys",
   "keys": "w i p"
  },
  {
   "find": [
    {
     "role": "AXTextArea",
     "value": "wip",
     "in": "Shelve Changes"
    }
   ]
  },
  {
   "do": "click",
   "label": "Shelve Changes",
   "role": "AXButton"
  },
  {
   "find": [
    {
     "label": "README.md",
     "role": "AXCheckBox"
    }
   ],
   "absent": true,
   "within": 5000
  },
  {
   "sh": "grep -rq 'DESCRIPTION\" value=\"wip' .idea/shelf && git diff --quiet HEAD -- README.md && ! git diff --quiet HEAD -- main.rs"
  }
 ]
}
