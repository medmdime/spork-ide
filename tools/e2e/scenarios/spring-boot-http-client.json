    },
    {
     "label": "Response file saved.",
     "in": "Response"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "sh": "grep -c '^<> ' requests.http",
   "is": "2",
   "within": 10000
  },
  {
   "sh": "ls \"../home/Library/Application Support/Spork IDE/workspace/\"*/httpRequests/ | grep -c '\\.200\\.txt$'",
   "is": "2"
  },
  {
