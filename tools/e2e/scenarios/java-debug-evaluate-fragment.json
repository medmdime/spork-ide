{
 "id": "java-debug-evaluate-fragment",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "find": {
    "label": "[Line] [:column]:",
    "role": "AXTextField"
   },
   "within": 5000
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames.0": "measure:44, Debuggee (com.example)",
    "run.debug.variables": [
     "name = \"Ada\""
    ]
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "alt-f8"
  },
  {
   "expect": {
    "windows.1.title": "Evaluate",
    "run.evaluate.mode": "expression"
   },
   "within": 5000
  },
  {
   "do": "activate",
   "window": "Evaluate"
  },
  {
   "do": "type",
   "text": "name",
   "window": "Evaluate"
  },
  {
   "do": "keys",
   "keys": "shift-enter",
   "window": "Evaluate"
  },
  {
   "expect": {
    "run.evaluate.mode": "code fragment"
   },
   "within": 5000
  },
  {
   "find": {
    "label": "Code fragment",
    "value": "name"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-a",
   "window": "Evaluate"
  },
  {
   "do": "type",
   "text": "int n = name.length();",
   "window": "Evaluate"
  },
  {
   "do": "keys",
   "keys": "enter",
   "window": "Evaluate"
  },
  {
   "do": "type",
   "text": "return n * 2;",
   "window": "Evaluate"
  },
  {
   "do": "keys",
   "keys": "cmd-enter",
   "window": "Evaluate"
  },
  {
   "expect": {
    "run.evaluate.result": "6"
   },
   "within": 20000
  },
  {
   "find": {
    "label": "result = 6"
   },
   "within": 5000
  },
  {
   "wait": 500
  },
  {
   "do": "activate",
   "window": "Evaluate"
  },
  {
   "wait": 500
  },
  {
   "shot": "fragment",
   "window": "smallest"
  },
  {
   "do": "keys",
   "keys": "escape",
   "window": "Evaluate"
  },
  {
   "expect": {
    "windows.1": null
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "alt-f8"
  },
  {
   "expect": {
    "windows.1.title": "Evaluate",
    "run.evaluate.mode": "code fragment"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "alt-m",
   "window": "Evaluate"
  },
  {
   "expect": {
    "run.evaluate.mode": "expression"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "escape",
   "window": "Evaluate"
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
