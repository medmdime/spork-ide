  {
   "do": "click",
   "label": "fixture",
   "role": "AXRow",
   "in": "Project Panel"
  },
  {
   "wait": 400
  },
  {
   "find": {
    "label": "greeting.rs",
    "role": "AXRow",
    "in": "Project Panel"
