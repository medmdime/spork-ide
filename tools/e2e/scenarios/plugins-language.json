{
 "id": "plugins-language",
 "covers": [],
 "reference-app": [],
 "settings": {
  "languages": {
   "Fixture": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "(nohup python3 \"$E2E/extensions_http.py\" ../registry-port 600 > ../registry.log 2>&1 &) && for i in $(seq 1800); do [ -s ../registry-port ] && break; sleep 0.1; done && python3 -c \"import json; p='../home/.config/spork-ide/settings.json'; s=json.load(open(p)); url='http://127.0.0.1:'+open('../registry-port').read().strip(); s['server_url']=url; s.setdefault('lsp', {})['fixture-ls']={'settings': {'download_url': url+'/files/lsp_fixture.py'}}; json.dump(s, open(p, 'w'))\""
  },
  {
   "wait": 1500
  },
  {
   "do": "keys",
   "keys": "cmd-,"
  },
  {
   "expect": {
    "windows.1.title": "Settings – fixture"
   },
   "within": 8000
  },
  {
   "do": "ui"
  },
  {
   "do": "click",
   "label": "Plugins",
   "role": "AXRow",
   "in": "Settings categories",
   "within": 8000
  },
  {
   "expect": {
    "settings.page": "Plugins",
    "settings.plugins.marketplace": [
     "Fixture Theme",
     "Fixture Language",
     "Fixture Snippets",
     "Fixture Icons",
     "Fixture MCP",
     "Fixture Debugger"
    ]
   },
   "within": 10000
  },
  {
   "do": "click",
   "label": "Search plugins",
   "role": "AXTextField"
  },
  {
   "do": "keys",
   "keys": "l a n g u a g e",
   "window": "Settings – fixture"
  },
  {
   "expect": {
    "settings.plugins.marketplace": [
     "Fixture Language"
    ]
   },
   "within": 8000
  },
  {
   "do": "click",
   "label": "Fixture Language",
   "in": "Plugins"
  },
  {
   "do": "click",
   "label": "Install",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings.plugins.installed": [
     "Fixture Language"
    ]
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings": null
   },
   "within": 8000
  },
  {
   "file": "data.fixture",
   "text": "{\"name\": \"fixture\", \"count\": 3, \"ok\": true, \"none\": null}\n"
  },
  {
   "do": "open",
   "path": "data.fixture"
  },
  {
   "expect": {
    "active": "data.fixture"
   },
   "within": 8000
  },
  {
   "do": "activate"
  },
  {
   "wait": 300
  },
  {
   "expect": {
    "editor.language": "Fixture",
    "editor.diagnostics": [
     "warning: fixture-ls: hello"
    ]
   },
   "within": 20000
  },
  {
   "sh": "ls '../home/Library/Application Support/Spork IDE/extensions/work/fixture-language'",
   "contains": "lsp_fixture.py"
  },
  {
   "do": "keys",
   "keys": "cmd-end"
  },
  {
   "do": "keys",
   "keys": "ctrl-space"
  },
  {
   "expect": {
    "editor.completions": [
     "fixtureCompletion"
    ]
   },
   "within": 8000
  },
  {
   "do": "keys",
   "keys": "escape"
  },
  {
   "wait": 1200
  },
  {
   "shot": "language"
  },
  {
   "do": "keys",
   "keys": "cmd-,"
  },
  {
   "expect": {
    "windows.1.title": "Settings – fixture"
   },
   "within": 8000
  },
  {
   "do": "ui"
  },
  {
   "do": "click",
   "label": "Plugins",
   "role": "AXRow",
   "in": "Settings categories",
   "within": 8000
  },
  {
   "expect": {
    "settings.page": "Plugins"
   },
   "within": 8000
  },
  {
   "do": "click",
   "label": "Installed",
   "role": "AXRadioButton"
  },
  {
   "expect": {
    "settings.plugins.tab": "Installed"
   }
  },
  {
   "do": "click",
   "label": "Fixture Language",
   "in": "Plugins"
  },
  {
   "do": "click",
   "label": "Uninstall",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings.plugins.installed": []
   },
   "within": 15000
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings": null
   },
   "within": 8000
  },
  {
   "expect": {
    "editor.language": null,
    "editor.diagnostics": []
   },
   "within": 10000
  }
 ]
}
