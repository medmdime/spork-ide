{
 "id": "java-debug-pause",
 "fixture": "maven",
 "covers": [
  "action:Pause"
 ],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\", \"args\": [\"--ask\"]}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Running"
   },
   "within": 60000
  },
  {
   "do": "click",
   "label": "Console",
   "role": "AXRadioButton"
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "Connected to the target VM, address: 'localhost:"
    }
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "not a number\nName?"
    }
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "debugger::Pause"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.threads": {
     "contains": "\"main\"@1: STOPPED"
    }
   },
   "within": 10000
  },
  {
   "expect": {
    "run.debug.threads": {
     "contains": "\"Common-Cleaner\"@6: STOPPED"
    }
   },
   "within": 10000
  },
  {
   "expect": {
    "editor.read_only": true
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "debugger::Continue"
  },
  {
   "expect": {
    "run.debug.status": "Running"
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.threads": {
     "contains": "\"main\"@1: RUNNING"
    }
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
