{
 "id": "java-debug-junit",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"DebuggeeTest\", \"adapter\": \"JUnit\", \"request\": \"launch\", \"testClass\": \"com.example.DebuggeeTest\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "DebuggeeTest"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'DebuggeeTest'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames.0": "measure:44, Debuggee (com.example)",
    "run.debug.frames.1": "measuresANameByItsLength:10, DebuggeeTest (com.example)",
    "run.debug.variables": [
     "name = \"Grace\""
    ]
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "cmd-alt-r"
  },
  {
   "expect": {
    "run.debug.console": {
     "contains": "Process finished with exit code 0"
    }
   },
   "within": 60000
  },
  {
   "do": "keys",
   "keys": "ctrl-r"
  },
  {
   "expect": {
    "run.tabs.0.title": "DebuggeeTest"
   },
   "within": 60000
  },
  {
   "expect": {
    "run.tabs.0.tests.status": "1 test passed"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.tabs.0.last_line": "Process finished with exit code 0"
   },
   "within": 30000
  }
 ]
}
