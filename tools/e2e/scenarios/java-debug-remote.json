{
 "id": "java-debug-remote",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Remote\", \"adapter\": \"Remote JVM Debug\", \"request\": \"attach\", \"hostName\": \"localhost\", \"port\": 5748}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Remote"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints.0.at": "Debuggee.java:44"
   }
  },
  {
   "sh": "test -f target/classes/com/example/Debuggee.class && echo yes",
   "is": "yes",
   "within": 60000
  },
  {
   "sh": "(\"$(/usr/libexec/java_home -v 17)/bin/java\" -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5747 -cp target/classes com.example.Debuggee > attached.txt 2>&1 & echo $! > attached.txt.pid)"
  },
  {
   "sh": "cat attached.txt",
   "contains": "Listening for transport dt_socket at address: 5747",
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "alt-shift-f5"
  },
  {
   "find": {
    "label": "Attach To"
   },
   "within": 10000
  },
  {
   "do": "type",
   "text": "Debuggee"
  },
  {
   "wait": 500
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "expect": {
    "run.debug.status": "Stopped",
    "run.debug.label": "localhost:5747",
    "run.debug.frames": [
     "measure:44, Debuggee (com.example)",
     "main:21, Debuggee (com.example)"
    ]
   },
   "within": 60000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "sh": "cat attached.txt",
   "contains": "13 3 Point[x=1, y=2]",
   "within": 30000
  },
  {
   "sh": "(\"$(/usr/libexec/java_home -v 17)/bin/java\" -agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5748 -cp target/classes com.example.Debuggee > remote.txt 2>&1 & echo $! > remote.txt.pid)"
  },
  {
   "sh": "cat remote.txt",
   "contains": "Listening for transport dt_socket at address: 5748",
   "within": 20000
  },
  {
   "find": {
    "label": "Debug 'Remote'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped",
    "run.debug.label": "Remote",
    "run.debug.frames": [
     "measure:44, Debuggee (com.example)",
     "main:21, Debuggee (com.example)"
    ]
   },
   "within": 60000
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "do": "keys",
   "keys": "cmd-alt-r"
  },
  {
   "sh": "cat remote.txt",
   "contains": "13 3 Point[x=1, y=2]",
   "within": 30000
  },
  {
   "do": "action",
   "name": "run::EditConfigurations"
  },
  {
   "expect": {
    "windows.1.title": "Run/Debug Configurations"
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "Remote JVM Debug",
     "role": "AXRow"
    },
    {
     "label": "Remote",
     "role": "AXRow"
    },
    {
     "label": "Attach to remote JVM"
    },
    {
     "label": "Host:",
     "role": "AXTextField",
     "value": "localhost"
    },
    {
     "label": "Port:",
     "role": "AXTextField",
     "value": "5748"
    },
    {
     "label": "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5748"
    },
    {
     "label": "Copy and paste the arguments to the command line when JVM is started"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "do": "click",
   "label": "Cancel",
   "role": "AXButton"
  },
  {
   "expect": {
    "windows.1": null
   },
   "within": 5000
  },
  {
   "sh": "kill $(cat attached.txt.pid remote.txt.pid) 2>/dev/null; true"
  }
 ]
}
