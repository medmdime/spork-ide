{
 "id": "plugins-snippets",
 "covers": [],
 "reference-app": [],
 "settings": {
  "completions": {
   "words": "disabled"
  }
 },
 "steps": [
  {
   "sh": "(nohup python3 \"$E2E/extensions_http.py\" ../registry-port 600 > ../registry.log 2>&1 &) && for i in $(seq 1800); do [ -s ../registry-port ] && break; sleep 0.1; done && python3 -c \"import json; p='../home/.config/spork-ide/settings.json'; s=json.load(open(p)); url='http://127.0.0.1:'+open('../registry-port').read().strip(); s['server_url']=url; s.setdefault('lsp', {})['fixture-ls']={'settings': {'download_url': url+'/files/lsp_fixture.py'}}; json.dump(s, open(p, 'w'))\""
  },
  {
   "wait": 1500
  },
  {
   "do": "keys",
   "keys": "cmd-,"
  },
  {
   "expect": {
    "windows.1.title": "Settings – fixture"
   },
   "within": 8000
  },
  {
   "do": "ui"
  },
  {
   "do": "click",
   "label": "Plugins",
   "role": "AXRow",
   "in": "Settings categories",
   "within": 8000
  },
  {
   "expect": {
    "settings.page": "Plugins",
    "settings.plugins.marketplace": [
     "Fixture Theme",
     "Fixture Language",
     "Fixture Snippets",
     "Fixture Icons",
     "Fixture MCP",
     "Fixture Debugger"
    ]
   },
   "within": 10000
  },
  {
   "do": "click",
   "label": "Search plugins",
   "role": "AXTextField"
  },
  {
   "do": "keys",
   "keys": "s n i p",
   "window": "Settings – fixture"
  },
  {
   "expect": {
    "settings.plugins.marketplace": [
     "Fixture Snippets"
    ]
   },
   "within": 8000
  },
  {
   "do": "click",
   "label": "Fixture Snippets",
   "in": "Plugins"
  },
  {
   "do": "click",
   "label": "Install",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings.plugins.installed": [
     "Fixture Snippets"
    ]
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings": null
   },
   "within": 8000
  },
  {
   "do": "open",
   "path": "src/main.rs"
  },
  {
   "expect": {
    "active": "src/main.rs"
   },
   "within": 8000
  },
  {
   "do": "activate"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-home down down down end enter"
  },
  {
   "do": "type",
   "text": "fixgre"
  },
  {
   "do": "keys",
   "keys": "ctrl-space"
  },
  {
   "expect": {
    "editor.completions": [
     "fixgreet"
    ]
   },
   "within": 8000
  },
  {
   "wait": 500
  },
  {
   "shot": "completion"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-s"
  },
  {
   "sh": "cat src/main.rs",
   "contains": "println!(\"Hello from the fixture snippet, name!\");",
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-,"
  },
  {
   "expect": {
    "windows.1.title": "Settings – fixture"
   },
   "within": 8000
  },
  {
   "do": "ui"
  },
  {
   "do": "click",
   "label": "Plugins",
   "role": "AXRow",
   "in": "Settings categories",
   "within": 8000
  },
  {
   "expect": {
    "settings.page": "Plugins"
   },
   "within": 8000
  },
  {
   "do": "click",
   "label": "Installed",
   "role": "AXRadioButton"
  },
  {
   "expect": {
    "settings.plugins.tab": "Installed"
   }
  },
  {
   "do": "click",
   "label": "Fixture Snippets",
   "in": "Plugins"
  },
  {
   "do": "click",
   "label": "Uninstall",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings.plugins.installed": []
   },
   "within": 15000
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "expect": {
    "settings": null
   },
   "within": 8000
  },
  {
   "do": "activate"
  },
  {
   "do": "keys",
   "keys": "end enter"
  },
  {
   "do": "type",
   "text": "fixgre"
  },
  {
   "do": "keys",
   "keys": "ctrl-space"
  },
  {
   "wait": 1500
  },
  {
   "expect": {
    "editor.completions": null
   }
  }
 ]
}
