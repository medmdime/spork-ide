  {
    "context": "Pane", // this is to override the default Pane mappings to switch tabs
    "bindings": {
      "ctrl-1": ["navigate::GoToBookmark", { "mnemonic": "1" }],
      "ctrl-2": ["navigate::GoToBookmark", { "mnemonic": "2" }],
      "ctrl-3": ["navigate::GoToBookmark", { "mnemonic": "3" }],
      "ctrl-4": ["navigate::GoToBookmark", { "mnemonic": "4" }],
      "ctrl-5": ["navigate::GoToBookmark", { "mnemonic": "5" }],
      "ctrl-6": ["navigate::GoToBookmark", { "mnemonic": "6" }],
      "ctrl-7": ["navigate::GoToBookmark", { "mnemonic": "7" }],
      "ctrl-8": ["navigate::GoToBookmark", { "mnemonic": "8" }],
      "ctrl-9": ["navigate::GoToBookmark", { "mnemonic": "9" }],
      "ctrl-0": ["navigate::GoToBookmark", { "mnemonic": "0" }],
      "alt-1": "project_panel::ToggleFocus",
      "alt-2": "bookmarks_panel::ToggleFocus",
      "alt-3": "find_panel::ToggleFocus",
      "alt-4": "run_panel::ToggleFocus",
      "alt-5": "debug_panel::ToggleFocus",
      "alt-6": "problems_panel::ToggleFocus",
      "alt-7": "outline_panel::ToggleFocus",
      "alt-8": "services_panel::ToggleFocus",
      "alt-9": "git_panel::ToggleFocus", // the Git tool window (bottom dock)
