   "ordered": true
  },
  {
   "do": "click",
   "label": "Copy Path"
  },
  {
   "sh": "pbpaste",
   "is": "$FIXTURE"
  },
  {
   "sh": "printf none | pbcopy"
  },
  {
   "do": "keys",
