{
 "id": "java-debug-condition-error",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "do": "keys",
   "keys": "cmd-shift-f8"
  },
  {
   "find": {
    "label": "Breakpoint",
    "role": "AXWindow"
   },
   "within": 5000
  },
  {
   "do": "click",
   "label": "Condition",
   "role": "AXTextField"
  },
  {
   "do": "type",
   "text": "nope > 1"
  },
  {
   "do": "click",
   "label": "Done",
   "role": "AXButton"
  },
  {
   "expect": {
    "run.breakpoints.0.condition": "nope > 1"
   }
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "find": [
    {
     "label": "Breakpoint Condition Error"
    },
    {
     "label": "Problem processing VM event:\nBreakpoint: 'Line 44 in Debuggee.measure() (com.example)'\nError: Cannot evaluate because of compilation error(s): nope cannot be resolved to a variable.\nWould you like to stop at the breakpoint?"
    }
   ],
   "ordered": true,
   "within": 60000
  },
  {
   "do": "click",
   "label": "Yes"
  },
  {
   "expect": {
    "run.debug.status": "Stopped",
    "run.debug.frames.0": "measure:44, Debuggee (com.example)"
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "debugger::Continue"
  },
  {
   "find": {
    "label": "Breakpoint Condition Error"
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "No"
  },
  {
   "expect": {
    "run.debug.status": "Running"
   },
   "within": 20000
  }
 ]
}
