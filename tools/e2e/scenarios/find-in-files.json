  {
   "do": "click",
   "label": "File mask:",
   "role": "AXCheckBox"
  },
  {
   "do": "click",
   "label": "In Project",
   "role": "AXRadioButton"
  },
  {
   "find": {
    "label": "2 matches in 2 files",
    "role": "AXStaticText"
