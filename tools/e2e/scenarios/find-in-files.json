    },
    {
     "label": "Search",
     "role": "AXTextField"
    },
    {
     "label": "Match Case",
     "role": "AXButton"
    },
    {
     "label": "Words",
     "role": "AXButton"
    },
    {
     "label": "Regex",
     "role": "AXButton"
    },
    {
