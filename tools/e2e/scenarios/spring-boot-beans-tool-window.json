{
 "id": "spring-boot-beans-tool-window",
 "fixture": "spring-maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   },
   "Spring Boot Properties": {
    "enable_language_server": true
   },
   "Spring Boot YAML": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "expect": {
    "java.tool": "Maven",
    "java.jdk": "17.0.20.1"
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 900000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 900000
  },
  {
   "expect": {
    "java.spring.classpath": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.spring.index.loaded": true,
    "java.spring.index.endpoints": [
     "GET /hello"
    ]
   },
   "within": 120000
  },
  {
   "do": "action",
   "name": "beans_tool_window::ToggleFocus"
  },
  {
   "expect": {
    "docks.right.open": true,
    "docks.right.panel": "Beans",
    "java.spring.beans.shown": [
     "demoApplication",
     "helloController"
    ]
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "Beans"
    },
    {
     "label": "demo"
    },
    {
     "label": "demoApplication"
    },
    {
     "label": "@SpringBootApplication"
    },
    {
     "label": "helloController"
    },
    {
     "label": "@RestController"
    },
    {
     "label": "Select bean to view documentation"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "do": "click",
   "label": "helloController"
  },
  {
   "expect": {
    "java.spring.beans.selected": "helloController"
   },
   "within": 3000
  },
  {
   "find": [
    {
     "label": "Documentation",
     "role": "AXRadioButton"
    },
    {
     "label": "helloController",
     "in": "Documentation"
    },
    {
     "label": "com.example.demo.HelloController",
     "in": "Documentation"
    },
    {
     "label": "@RestController",
     "in": "Documentation"
    },
    {
     "label": "HelloController.java",
     "in": "Documentation"
    }
   ],
   "within": 3000
  },
  {
   "do": "activate"
  },
  {
   "wait": 1000
  },
  {
   "shot": "beans"
  },
  {
   "do": "action",
   "name": "beans_tool_window::CompactListItems"
  },
  {
   "find": {
    "label": "@SpringBootApplication"
   },
   "absent": true,
   "within": 3000
  },
  {
   "do": "click",
   "label": "helloController",
   "count": 2
  },
  {
   "expect": {
    "active": "src/main/java/com/example/demo/HelloController.java"
   },
   "within": 10000
  }
 ]
}
