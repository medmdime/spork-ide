  {
    "context": "Pane",
    "bindings": {
      "ctrl-alt-left": "pane::GoBack",
      "ctrl-alt-right": "pane::GoForward",
      "alt-left": "pane::ActivatePreviousItem",
      "alt-right": "pane::ActivateNextItem",
      "ctrl-shift-f": "navigate::FindInFiles",
    },
  },
  {
    // IntelliJ's Resize ▸ Stretch to Left/Right/Top/Bottom, in a tool window
    "context": "Dock",
