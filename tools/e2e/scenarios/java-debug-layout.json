{
 "id": "java-debug-layout",
 "fixture": "maven",
 "covers": [
  "action:Runner.RestoreLayout",
  "action:Runner.ToggleTabLabels",
  "action:XDebugger.SeparateWatches"
 ],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "find": {
    "label": "[Line] [:column]:",
    "role": "AXTextField"
   },
   "within": 5000
  },
  {
   "do": "type",
   "text": "49:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames.0": "twice:49, Debuggee (com.example)",
    "run.debug.layout": {
     "frames": "Combined",
     "variables": true,
     "console": true,
     "separate_watches": false,
     "tab_labels": true
    }
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "Layout Settings",
   "role": "AXButton"
  },
  {
   "find": [
    {
     "label": "Threads & Frames"
    },
    {
     "label": "Variables",
     "role": "AXMenuItem"
    },
    {
     "label": "Console",
     "role": "AXMenuItem"
    },
    {
     "label": "Separate Watches"
    },
    {
     "label": "Show Tab Labels"
    },
    {
     "label": "Restore Default Layout"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "do": "click",
   "label": "Threads & Frames"
  },
  {
   "find": [
    {
     "label": "Combined"
    },
    {
     "label": "Threads",
     "role": "AXMenuItem"
    },
    {
     "label": "Side-by-Side"
    },
    {
     "label": "Show Frames Only"
    },
    {
     "label": "Don't Show"
    }
   ],
   "ordered": true,
   "within": 5000
  },
  {
   "do": "click",
   "label": "Side-by-Side"
  },
  {
   "expect": {
    "run.debug.layout.frames": "SideBySide"
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "\"worker\"@11: STOPPED",
     "role": "AXRow",
     "in": "Threads"
    },
    {
     "label": "twice:49, Debuggee (com.example)",
     "in": "Frames"
    }
   ],
   "within": 10000
  },
  {
   "do": "click",
   "label": "\"main\"@1: STOPPED",
   "role": "AXRow",
   "in": "Threads"
  },
  {
   "expect": {
    "run.debug.thread": "\"main\"@1: STOPPED",
    "run.debug.frames": {
     "contains": "main:29, Debuggee (com.example)"
    }
   },
   "within": 10000
  },
  {
   "do": "click",
   "label": "\"worker\"@11: STOPPED",
   "role": "AXRow",
   "in": "Threads"
  },
  {
   "expect": {
    "run.debug.frames.0": "twice:49, Debuggee (com.example)"
   },
   "within": 10000
  },
  {
   "wait": 1000
  },
  {
   "do": "activate"
  },
  {
   "wait": 500
  },
  {
   "shot": "side-by-side"
  },
  {
   "do": "click",
   "label": "Layout Settings",
   "role": "AXButton"
  },
  {
   "do": "click",
   "label": "Threads & Frames"
  },
  {
   "do": "click",
   "label": "Threads",
   "role": "AXMenuItem"
  },
  {
   "expect": {
    "run.debug.layout.frames": "Threads"
   },
   "within": 5000
  },
  {
   "find": [
    {
     "label": "\"worker\"@11: STOPPED",
     "role": "AXRow"
    },
    {
     "label": "twice:49, Debuggee (com.example)"
    },
    {
     "label": "\"main\"@1: STOPPED",
     "role": "AXRow"
    }
   ],
   "ordered": true,
   "within": 10000
  },
  {
   "do": "click",
   "label": "Layout Settings",
   "role": "AXButton"
  },
  {
   "do": "click",
   "label": "Separate Watches"
  },
  {
   "expect": {
    "run.debug.layout.separate_watches": true
   },
   "within": 5000
  },
  {
   "find": {
    "label": "No watches"
   },
   "within": 5000
  },
  {
   "do": "click",
   "label": "Evaluate expression (⏎) or add a watch (⇧⌘⏎)",
   "role": "AXTextField"
  },
  {
   "do": "type",
   "text": "value * 2"
  },
  {
   "do": "keys",
   "keys": "shift-cmd-enter"
  },
  {
   "find": {
    "label": "value * 2 = 26",
    "role": "AXRow",
    "in": "Watches"
   },
   "within": 20000
  },
  {
   "expect": {
    "run.debug.variables": [
     "value = 13"
    ]
   },
   "within": 10000
  },
  {
   "wait": 1000
  },
  {
   "do": "activate"
  },
  {
   "wait": 500
  },
  {
   "shot": "separate-watches"
  },
  {
   "do": "click",
   "label": "Layout Settings",
   "role": "AXButton"
  },
  {
   "do": "click",
   "label": "Console",
   "role": "AXMenuItem"
  },
  {
   "expect": {
    "run.debug.layout.console": false
   },
   "within": 5000
  },
  {
   "find": {
    "label": "Console",
    "role": "AXRadioButton"
   },
   "absent": true,
   "within": 5000
  },
  {
   "do": "click",
   "label": "Layout Settings",
   "role": "AXButton"
  },
  {
   "do": "click",
   "label": "Restore Default Layout"
  },
  {
   "expect": {
    "run.debug.layout": {
     "frames": "Combined",
     "variables": true,
     "console": true,
     "separate_watches": false,
     "tab_labels": true
    }
   },
   "within": 5000
  },
  {
   "find": {
    "label": "Console",
    "role": "AXRadioButton"
   },
   "within": 5000
  },
  {
   "expect": {
    "run.debug.variables": [
     "value = 13",
     "value * 2 = 26"
    ]
   },
   "within": 10000
  },
  {
   "do": "click",
   "label": "Layout Settings",
   "role": "AXButton"
  },
  {
   "do": "click",
   "label": "Show Tab Labels"
  },
  {
   "expect": {
    "run.debug.layout.tab_labels": false
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
