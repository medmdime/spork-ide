{
 "id": "java-debug-menus",
 "fixture": "maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "49:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames": [
     "twice:49, Debuggee (com.example)",
     "lambda$1:27, Debuggee (com.example)",
     "2 hidden frames"
    ],
    "run.debug.thread": "\"worker\"@11: STOPPED"
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "twice:49, Debuggee (com.example)",
   "button": "right"
  },
  {
   "menu": "context-menu:XDebugger.Frames.Tree.Popup",
   "items": [
    "Reset Frame",
    "Throw Exception (disabled)",
    "Force Return (disabled)",
    "Copy Stack",
    "Hide Frames from Libraries",
    "Async Stack Traces (disabled)",
    "Customize Threads View…",
    "Add Stepping Filter…",
    "Export Threads…"
   ],
   "checked": [
    "Hide Frames from Libraries"
   ]
  },
  {
   "do": "click",
   "label": "Copy Stack"
  },
  {
   "sh": "pbpaste",
   "is": "twice:49, Debuggee (com.example)\nlambda$1:27, Debuggee (com.example)\n2 hidden frames",
   "within": 5000
  },
  {
   "do": "click",
   "label": "value = 13",
   "button": "right"
  },
  {
   "menu": "context-menu:XDebugger.Variables.Tree.Popup",
   "items": [
    "New Class Level Watch… (disabled)",
    "Inspect…",
    "Mark Object… (disabled)",
    "Set Value…",
    "Copy Value",
    "Compare Value with Clipboard (disabled)",
    "Copy Name",
    "Evaluate Expression…",
    "Add to Watches",
    "Show Referring Objects… (disabled)",
    "Jump To Source",
    "Jump To Type Source (disabled)",
    "View Text (disabled)",
    "View as",
    "Filter… (disabled)",
    "Adjust Range… (disabled)",
    "Show types",
    "Mute Renderers (disabled)",
    "Customize Data Views… (disabled)"
   ],
   "checked": [
    "Show types"
   ]
  },
  {
   "do": "click",
   "label": "Copy Value"
  },
  {
   "sh": "pbpaste",
   "is": "13",
   "within": 5000
  },
  {
   "do": "click",
   "label": "\"worker\"@11: STOPPED",
   "role": "AXPopUpButton"
  },
  {
   "find": {
    "label": "\"main\"@1: STOPPED"
   },
   "within": 5000
  },
  {
   "do": "click",
   "label": "\"main\"@1: STOPPED"
  },
  {
   "expect": {
    "run.debug.thread": "\"main\"@1: STOPPED"
   },
   "within": 10000
  },
  {
   "expect": {
    "run.debug.frames": {
     "contains": "main:29, Debuggee (com.example)"
    }
   },
   "within": 10000
  }
 ]
}
