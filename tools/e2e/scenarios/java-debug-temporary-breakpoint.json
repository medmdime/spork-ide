{
 "id": "java-debug-temporary-breakpoint",
 "fixture": "maven",
 "covers": [
  "action:ToggleTemporaryLineBreakpoint"
 ],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '%s' '[{\"label\": \"Debuggee\", \"adapter\": \"Java\", \"request\": \"launch\", \"mainClass\": \"com.example.Debuggee\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 300000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 600000
  },
  {
   "expect": {
    "run.configurations.selected": "Debuggee"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Debuggee.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Debuggee.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "44:1"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "alt-shift-cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints.0.at": "Debuggee.java:44",
    "run.breakpoints.0.temporary": true
   }
  },
  {
   "do": "keys",
   "keys": "cmd-shift-f8"
  },
  {
   "find": [
    {
     "label": "Breakpoint",
     "role": "AXWindow"
    },
    {
     "label": "Remove once hit",
     "role": "AXCheckBox",
     "value": "1"
    }
   ],
   "ordered": true,
   "within": 8000
  },
  {
   "do": "click",
   "label": "Done",
   "role": "AXButton"
  },
  {
   "find": {
    "label": "Debug 'Debuggee'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "run.debug.status": "Stopped"
   },
   "within": 120000
  },
  {
   "expect": {
    "run.debug.frames.0": "measure:44, Debuggee (com.example)",
    "run.breakpoints": []
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "cmd-alt-r"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  },
  {
   "do": "keys",
   "keys": "alt-shift-cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints.0.temporary": true
   }
  },
  {
   "do": "keys",
   "keys": "alt-shift-cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints": []
   }
  }
 ]
}
