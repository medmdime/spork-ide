    },
    {
     "label": "greeting.rs 1",
     "role": "AXStaticText"
    },
    {
     "label": "format!(\"Hello, {name}!\")",
     "role": "AXStaticText"
    },
    {
     "label": "greeting.rs 2",
     "role": "AXStaticText"
    },
    {
     "label": "println!(\"{}\", greeting::hello(\"world\"));",
     "role": "AXStaticText"
    },
    {
     "label": "main.rs 4",
     "role": "AXStaticText"
    }
