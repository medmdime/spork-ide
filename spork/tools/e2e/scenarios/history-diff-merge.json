{
 "id": "history-diff-merge",
 "covers": [
  "action:Diff.NextConflict",
  "action:Diff.PreviousConflict"
 ],
 "reference-app": [],
 "steps": [
  {"sh": "printf 'a\\nX\\nb\\nc\\nd\\ne\\nf\\ng\\nY\\nh\\n' > m.txt && git add m.txt && git commit -q -m base -- m.txt && git checkout -q -b m1 && printf 'a\\nT1\\nb\\nc\\nd\\ne\\nf\\ng\\nT2\\nh\\n' > m.txt && git commit -q -m theirs -- m.txt && git checkout -q main && printf 'a\\nO1\\nb\\nc\\nd\\ne\\nf\\ng\\nO2\\nh\\n' > m.txt && git commit -q -m ours -- m.txt && (git merge m1 >/dev/null 2>&1 || true) && test \"$(grep -c '^<<<<<<<' m.txt)\" = 2"},
  {"do": "git", "args": ["status"]},
  {"wait": 800},
  {"do": "open", "what": "change", "path": "m.txt"},
  {"expect": {"view": "Changes", "change_file": "m.txt", "merge_conflicts": [null, null], "merge_selected": null, "merge_result": null}, "of": {"do": "history"}},
  {"do": "keys", "keys": "ctrl-cmd-right"},
  {"expect": {"merge_conflicts": [null, null]}, "of": {"do": "history"}},
  {"do": "action", "name": "spork::CommandPalette"},
  {"expect": {"search_everywhere": true}},
  {"wait": 400},
  {"do": "keys", "keys": "P r e v i o u s space C o n f l i c t"},
  {"wait": 400},
  {"do": "keys", "keys": "enter"},
  {"expect": {"search_everywhere": false}},
  {"expect": {"merge_selected": 1}, "of": {"do": "history"}},
  {"do": "keys", "keys": "escape"},
  {"do": "action", "name": "diff::PreviousConflict"},
  {"expect": {"merge_selected": 0}, "of": {"do": "history"}},
  {"do": "action", "name": "diff::NextConflict"},
  {"expect": {"merge_selected": 1}, "of": {"do": "history"}},
  {"do": "action", "name": "diff::NextConflict"},
  {"expect": {"merge_selected": 1}, "of": {"do": "history"}},
  {"do": "action", "name": "diff::PreviousConflict"},
  {"expect": {"merge_selected": 0}, "of": {"do": "history"}},
  {"do": "keys", "keys": "ctrl-cmd-left"},
  {"expect": {"merge_conflicts": ["Incoming", null]}, "of": {"do": "history"}},
  {"do": "action", "name": "diff::NextConflict"},
  {"expect": {"merge_selected": 1}, "of": {"do": "history"}},
  {"do": "action", "name": "diff::PreviousConflict"},
  {"expect": {"merge_selected": 1}, "of": {"do": "history"}},
  {"do": "keys", "keys": "ctrl-cmd-right"},
  {"expect": {"merge_conflicts": ["Incoming", "Current"], "merge_result": "a\nT1\nb\nc\nd\ne\nf\ng\nO2\nh\n"}, "of": {"do": "history"}},
  {"wait": 500},
  {"shot": "resolved"}
 ]
}
