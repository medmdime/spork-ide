  {
   "do": "activate"
  },
  {
   "wait": 1000
  },
  {
   "shot": "dependencies"
  },
  {
   "do": "click",
   "label": "Create",
   "role": "AXButton"
  },
  {
   "sh": "grep -c '<artifactId>spring-boot-starter-webmvc</artifactId>' ../home/SporkIdeProjects/demo/pom.xml",
   "is": "1",
   "within": 20000
  },
  {
   "sh": "test -x ../home/SporkIdeProjects/demo/mvnw && test -f ../home/SporkIdeProjects/demo/src/main/java/com/example/demo/DemoApplication.java && echo ok",
   "is": "ok"
  },
  {
   "find": {
    "label": "demo",
    "role": "AXButton",
    "in": "Title bar"
   },
   "within": 15000
  },
  {
   "expect": {
    "java.tool": "Maven",
    "java.jdk": "17.0.20.1"
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 900000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 900000
