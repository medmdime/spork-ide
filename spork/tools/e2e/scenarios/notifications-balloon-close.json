{
 "id": "notifications-balloon-close",
 "covers": [],
 "reference-app": [],
 "steps": [
  {
   "find": {
    "label": "Notifications",
    "role": "AXButton"
   },
   "within": 10000
  },
  {
   "do": "action",
   "name": "spork::ToggleProject"
  },
  {
   "expect": {
    "left": "[]"
   }
  },
  {
   "do": "notify",
   "type": "info",
   "title": "Close me",
   "text": "A balloon closes from its close button, which shows under the pointer.",
   "sticky": true
  },
  {
   "find": {
    "label": "Close. ⌥click to close all notifications"
   },
   "absent": true
  },
  {
   "do": "click",
   "label": "Close me",
   "role": "AXGroup",
   "hover": true
  },
  {
   "find": {
    "label": "Close. ⌥click to close all notifications",
    "in": "Close me"
   },
   "within": 3000
  },
  {
   "wait": 300
  },
  {
   "shot": "hover"
  },
  {
   "do": "click",
   "label": "Close. ⌥click to close all notifications",
   "in": "Close me"
  },
  {
   "expect": {
    "balloons.0": null
   },
   "of": {
    "do": "balloons"
   }
  },
  {
   "do": "notify",
   "type": "info",
   "title": "One",
   "text": "The first one.",
   "sticky": true
  },
  {
   "do": "notify",
   "type": "info",
   "title": "Two",
   "text": "The second one.",
   "sticky": true
  },
  {
   "do": "click",
   "label": "Two",
   "role": "AXGroup",
   "hover": true
  },
  {
   "do": "click",
   "label": "Close. ⌥click to close all notifications",
   "in": "Two",
   "modifiers": [
    "alt"
   ]
  },
  {
   "expect": {
    "balloons.0": null
   },
   "of": {
    "do": "balloons"
   }
  }
 ]
}
