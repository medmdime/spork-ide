    {
     "label": "greeting.rs",
     "role": "AXRow",
     "in": "Find Results"
    },
    {
     "label": "pub fn hello(name: &str) -> String {",
     "role": "AXRow",
     "selected": true
    },
    {
     "label": "main.rs",
     "role": "AXRow",
     "in": "Find Results"
    },
    {
     "label": "println!(\"{}\", greeting::hello(\"world\"));",
     "role": "AXRow"
    }
   ],
   "ordered": true
