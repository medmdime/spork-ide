  {
   "do": "click",
   "label": "Submit Request",
   "role": "AXButton"
  },
  {
   "expect": {
    "http.runs.2.name": "Endpoints | #1",
    "http.runs.2.text": {
     "contains": "Hello, world!"
    }
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "Open in HTTP Client",
   "role": "AXLink"
  },
