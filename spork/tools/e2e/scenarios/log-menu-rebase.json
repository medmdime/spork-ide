{
 "id": "log-menu-rebase",
 "covers": [],
 "reference-app": [],
 "steps": [
  {"sh": "export GIT_AUTHOR_DATE=2026-01-09T10:00:00Z GIT_COMMITTER_DATE=2026-01-09T10:00:00Z && printf 'a\\n' > a.txt && git add a.txt && git commit -q -m one && printf 'b\\n' > b.txt && git add b.txt && git commit -q -m two && printf 'c\\n' > c.txt && git add c.txt && git commit -q -m three"},
  {"expect": {"commits": 10}, "within": 8000},
  {"do": "ui"},
  {"wait": 500},
  {"find": {"label": "one", "role": "AXRow"}},
  {"do": "click", "label": "one", "role": "AXRow", "button": "right"},
  {"find": {"label": "Interactively Rebase from Here…", "role": "AXMenuItem"}},
  {"do": "click", "label": "Interactively Rebase from Here…", "role": "AXMenuItem"},
  {"find": {"label": "Rebasing Commits", "role": "AXGroup"}, "within": 8000},
  {"expect": {"log.rebase": ["pick one", "pick two", "pick three"]}},
  {"find": [{"label": "three", "role": "AXRow"}, {"label": "two", "role": "AXRow"}, {"label": "one", "role": "AXRow"}], "ordered": true},
  {"toolbar": "Rebasing Commits Toolbar", "items": ["Move Up (disabled)", "Move Down", "Pick", "Edit", "Reword", "Squash", "Fixup", "Drop"]},
  {"find": {"label": "Reset", "role": "AXLink", "enabled": false}},
  {"find": {"label": "c.txt", "in": "Rebasing Commits"}},
  {"shot": "dialog"},
  {"do": "click", "label": "one", "role": "AXRow", "in": "Rebasing Commits Table"},
  {"do": "keys", "keys": "d"},
  {"expect": {"log.rebase": ["drop one", "pick two", "pick three"]}},
  {"do": "click", "label": "Reset", "role": "AXLink"},
  {"expect": {"log.rebase": ["pick one", "pick two", "pick three"]}},
  {"do": "click", "label": "three", "role": "AXRow", "in": "Rebasing Commits Table"},
  {"do": "keys", "keys": "alt-down"},
  {"expect": {"log.rebase": ["pick one", "pick three", "pick two"]}},
  {"do": "keys", "keys": "alt-up"},
  {"expect": {"log.rebase": ["pick one", "pick two", "pick three"]}},
  {"wait": 500},
  {"do": "click", "label": "two", "role": "AXRow", "in": "Rebasing Commits Table"},
  {"expect": {"log.rebase_selected": ["two"]}},
  {"find": {"label": "b.txt", "in": "Rebasing Commits"}},
  {"do": "keys", "keys": "r"},
  {"wait": 300},
  {"do": "keys", "keys": "escape"},
  {"expect": {"log.rebase_selected": ["two"]}},
  {"find": {"label": "Rebasing Commits", "role": "AXGroup"}},
  {"expect": {"log.rebase": ["pick one", "pick two", "pick three"]}},
  {"do": "keys", "keys": "r"},
  {"wait": 300},
  {"expect": {"log.rebase_selected": ["two"]}},
  {"do": "keys", "keys": "cmd-a t w o space r e w o r d e d"},
  {"do": "keys", "keys": "cmd-enter"},
  {"expect": {"log.rebase": ["pick one", "reword two", "pick three"]}},
  {"find": {"label": "two reworded", "role": "AXRow"}},
  {"wait": 500},
  {"do": "click", "label": "three", "role": "AXRow", "in": "Rebasing Commits Table"},
  {"do": "keys", "keys": "s"},
  {"expect": {"log.rebase": ["pick one", "reword two", "squash three"]}},
  {"wait": 500},
  {"do": "click", "label": "one", "role": "AXRow", "in": "Rebasing Commits Table"},
  {"do": "click", "label": "Drop", "role": "AXButton"},
  {"expect": {"log.rebase": ["drop one", "reword two", "squash three"]}},
  {"shot": "plan"},
  {"do": "click", "label": "Start Rebasing", "role": "AXButton"},
  {"git": ["log", "-2", "--format=%s"], "is": "two reworded\nMerge branch 'feature/login'"},
  {"git": ["show", "--name-only", "--format=", "HEAD"], "is": "b.txt\nc.txt"},
  {"git": ["ls-files", "a.txt"], "is": ""},
  {"expect": {"log.rebase": null}}
 ]
}
