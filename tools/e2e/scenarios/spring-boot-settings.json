{
 "id": "spring-boot-settings",
 "fixture": "spring-maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   },
   "Spring Boot Properties": {
    "enable_language_server": true
   },
   "Spring Boot YAML": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "expect": {
    "java.tool": "Maven",
    "java.jdk": "17.0.20.1"
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "cmd-,"
  },
  {
   "expect": {
    "windows.1.title": "Settings – fixture"
   },
   "within": 8000
  },
  {
   "do": "ui"
  },
  {
   "do": "click",
   "label": "Languages & Frameworks",
   "role": "AXRow",
   "in": "Settings categories"
  },
  {
   "do": "click",
   "label": "Spring",
   "role": "AXRow",
   "in": "Settings categories"
  },
  {
   "expect": {
    "settings.page": "Languages & Frameworks/Spring"
   },
   "within": 5000
  },
  {
   "toolbar": "Settings page",
   "items": [
    "Create run configuration automatically"
   ],
   "within": 5000
  },
  {
   "do": "activate",
   "window": "Settings – fixture"
  },
  {
   "wait": 1000
  },
  {
   "shot": "settings",
   "window": "smallest"
  },
  {
   "do": "click",
   "label": "Create run configuration automatically",
   "role": "AXCheckBox"
  },
  {
   "do": "click",
   "label": "OK",
   "role": "AXButton"
  },
  {
   "expect": {
    "value": false
   },
   "of": {
    "do": "setting",
    "path": "/spork/spring_boot/create_run_configuration"
   },
   "within": 8000
  },
  {
   "expect": {
    "java.linked": true,
    "java.server.running": true
   },
   "within": 900000
  },
  {
   "expect": {
    "java.server.busy": false
   },
   "within": 900000
  },
  {
   "expect": {
    "java.spring.classpath": true
   },
   "within": 300000
  },
  {
   "expect": {
    "run.configurations.names": [],
    "run.configurations.selected": null
   }
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/demo/DemoApplication.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/demo/DemoApplication.java",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 800
  },
  {
   "do": "type",
   "text": "9:5"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "do": "keys",
   "keys": "ctrl-r"
  },
  {
   "expect": {
    "run.configurations.names": [
     "DemoApplication"
    ],
    "run.configurations.selected": "DemoApplication"
   },
   "within": 60000
  },
  {
   "sh": "cat \"../home/Library/Application Support/Spork IDE/workspace/\"*/debug.json",
   "contains": "\"adapter\": \"Spring Boot\"",
   "within": 8000
  },
  {
   "expect": {
    "run.tabs.0.title": "DemoApplication",
    "run.services.services.DemoApplication.starting": false,
    "run.services.services.DemoApplication.link": [
     ":18081/",
     "http://localhost:18081/"
    ]
   },
   "within": 120000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.tabs.0.running": false
   },
   "within": 20000
  }
 ]
}
