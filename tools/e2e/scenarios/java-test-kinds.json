{
 "id": "java-test-kinds",
 "fixture": "tests-maven",
 "covers": [],
 "settings": {
  "languages": {
   "Java": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p src/test/java/com/example/kinds src/test/resources .zed"
  },
  {
   "file": "src/test/java/com/example/kinds/TaggedTest.java",
   "text": "package com.example.kinds;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\nimport org.junit.jupiter.api.Tag;\nimport org.junit.jupiter.api.Test;\n\nclass TaggedTest {\n    @Tag(\"fast\")\n    @Test\n    void fast() {\n        assertEquals(2, 1 + 1);\n    }\n\n    @Test\n    void untagged() {\n        assertEquals(4, 2 + 2);\n    }\n}\n"
  },
  {
   "file": "src/test/java/com/example/kinds/Slow.java",
   "text": "package com.example.kinds;\n\npublic interface Slow {\n}\n"
  },
  {
   "file": "src/test/java/com/example/kinds/CategoryTest.java",
   "text": "package com.example.kinds;\n\nimport static org.junit.Assert.assertEquals;\n\nimport org.junit.Test;\nimport org.junit.experimental.categories.Category;\n\npublic class CategoryTest {\n    @Category(Slow.class)\n    @Test\n    public void slow() {\n        assertEquals(6, 2 * 3);\n    }\n\n    @Test\n    public void quick() {\n        assertEquals(1, 1);\n    }\n}\n"
  },
  {
   "file": "src/test/java/com/example/kinds/GroupedTest.java",
   "text": "package com.example.kinds;\n\nimport static org.testng.Assert.assertEquals;\n\nimport org.testng.annotations.Test;\n\npublic class GroupedTest {\n    @Test(groups = \"smoke\")\n    public void smokes() {\n        assertEquals(1 + 1, 2);\n    }\n\n    @Test\n    public void ungrouped() {\n        assertEquals(2 + 2, 4);\n    }\n}\n"
  },
  {
   "file": "src/test/resources/testng.xml",
   "text": "<!DOCTYPE suite SYSTEM \"https://testng.org/testng-1.0.dtd\">\n<suite name=\"Kinds\">\n    <test name=\"Grouped\">\n        <classes>\n            <class name=\"com.example.kinds.GroupedTest\"/>\n        </classes>\n    </test>\n</suite>\n"
  },
  {
   "file": ".zed/debug.json",
   "text": "[\n  {\n    \"label\": \"Fast tests\",\n    \"adapter\": \"JUnit\",\n    \"request\": \"launch\",\n    \"testKind\": \"tags\",\n    \"testTags\": \"fast\"\n  },\n  {\n    \"label\": \"Slow tests\",\n    \"adapter\": \"JUnit\",\n    \"request\": \"launch\",\n    \"testKind\": \"category\",\n    \"testCategory\": \"com.example.kinds.Slow\"\n  },\n  {\n    \"label\": \"One test\",\n    \"adapter\": \"JUnit\",\n    \"request\": \"launch\",\n    \"testKind\": \"uniqueId\",\n    \"testUniqueId\": \"[engine:junit-jupiter]/[class:com.example.kinds.TaggedTest]/[method:untagged()]\"\n  },\n  {\n    \"label\": \"Kinds\",\n    \"adapter\": \"JUnit\",\n    \"request\": \"launch\",\n    \"testKind\": \"directory\",\n    \"testDirectory\": \"src/test/java/com/example/kinds\"\n  },\n  {\n    \"label\": \"Smoke\",\n    \"adapter\": \"TestNG\",\n    \"request\": \"launch\",\n    \"testKind\": \"group\",\n    \"testGroup\": \"smoke\"\n  },\n  {\n    \"label\": \"Suite\",\n    \"adapter\": \"TestNG\",\n    \"request\": \"launch\",\n    \"testKind\": \"suite\",\n    \"testSuite\": \"src/test/resources/testng.xml\"\n  },\n  {\n    \"label\": \"Patterns\",\n    \"adapter\": \"JUnit\",\n    \"request\": \"launch\",\n    \"testKind\": \"pattern\",\n    \"testPattern\": \"com.example.kinds.TaggedTest||com.example.CalculatorTest\"\n  },\n  {\n    \"label\": \"Forked\",\n    \"adapter\": \"JUnit\",\n    \"request\": \"launch\",\n    \"testKind\": \"package\",\n    \"testPackage\": \"com.example.kinds\",\n    \"forkMode\": \"class\"\n  }\n]\n"
  },
  {
