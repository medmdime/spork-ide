  "action:Git.CreateNewTag"
 ],
 "reference-app": [],
 "steps": [
  {
   "find": {
    "text": "docs: a second line",
    "role": "AXRow"
   }
  },
  {
   "do": "click",
   "label": "docs: a second line",
   "role": "AXRow",
   "button": "right"
  },
  {
   "find": {
