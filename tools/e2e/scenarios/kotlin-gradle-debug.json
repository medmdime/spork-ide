{
 "id": "kotlin-gradle-debug",
 "fixture": "kotlin-gradle",
 "covers": [],
 "settings": {
  "languages": {
   "Kotlin": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '[{\"label\": \"MainKt\", \"adapter\": \"Kotlin\", \"request\": \"launch\", \"mainClass\": \"com.example.MainKt\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Gradle",
    "kotlin.detected": true
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "kotlin.server.running": true
   },
   "within": 600000
  },
  {
   "expect": {
    "kotlin.server.busy": false
   },
   "within": 300000
  },
  {
   "expect": {
    "run.configurations.names": [
     "MainKt"
    ],
    "run.configurations.selected": "MainKt"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/kotlin/com/example/Main.kt"
  },
  {
   "expect": {
    "active": "src/main/kotlin/com/example/Main.kt"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "7:9"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "do": "open",
   "path": "src/main/kotlin/com/example/Main.kt"
  },
  {
   "expect": {
    "active": "src/main/kotlin/com/example/Main.kt"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "13:9"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "do": "open",
   "path": "src/main/java/com/example/Greeting.java"
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Greeting.java"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "12:9"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "find": {
    "label": "Debug 'MainKt'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "docks.bottom.open": true,
    "docks.bottom.panel": "DebugPanel",
    "run.debug.status": "Stopped"
   },
   "within": 180000
  },
  {
   "find": {
    "label": "main:7, MainKt (com.example)",
    "selected": true
   },
   "within": 10000
  },
  {
   "wait": 1500
  },
  {
   "do": "activate"
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "expect": {
    "docks.left.open": false
   }
  },
  {
   "wait": 1500
  },
  {
   "do": "activate"
  },
  {
   "shot": "stopped-in-lambda"
  },
  {
   "do": "click",
   "label": "Evaluate expression (⏎) or add a watch (⇧⌘⏎)",
   "role": "AXTextField"
  },
  {
   "do": "type",
   "text": "name"
  },
  {
   "do": "keys",
   "keys": "shift-cmd-enter"
  },
  {
   "expect": {
    "run.debug.watches.name": "\"world\""
   },
   "within": 20000
  },
  {
   "do": "click",
   "label": "Evaluate expression (⏎) or add a watch (⇧⌘⏎)",
   "role": "AXTextField"
  },
  {
   "do": "type",
   "text": "\"$name!\""
  },
  {
   "do": "keys",
   "keys": "shift-cmd-enter"
  },
  {
   "expect": {
    "run.debug.watch_order": [
     "name",
     "\"$name!\""
    ]
   },
   "within": 5000
  },
  {
   "expect": {
    "run.debug.watches": {
     "name": "\"world\"",
     "\"$name!\"": "\"world!\""
    }
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "alt-cmd-r"
  },
  {
   "find": {
    "label": "greet:13, MainKt (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "expect": {
    "run.debug.status": "Stopped",
    "run.debug.watches": {
     "name": "\"world\"",
     "\"$name!\"": "\"world!\""
    }
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "f8"
  },
  {
   "find": {
    "label": "greet:14, MainKt (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "do": "keys",
   "keys": "f7"
  },
  {
   "find": {
    "label": "text:12, Greeting (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "expect": {
    "active": "src/main/java/com/example/Greeting.java",
    "run.debug.watches.name": "\"world\""
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "shift-f8"
  },
  {
   "find": {
    "label": "greet:14, MainKt (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
