{
 "id": "docker-services-tree",
 "covers": [],
 "reference-app": [],
 "steps": [
  {
   "sh": "(nohup python3 \"$E2E/docker_engine.py\" ../home/.docker/run/docker.sock ../docker-calls.log 600 > /dev/null 2>&1 &) && for i in $(seq 50); do [ -S ../home/.docker/run/docker.sock ] && break; sleep 0.1; done && [ -S ../home/.docker/run/docker.sock ]"
  },
  {
   "do": "open",
   "path": "README.md"
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "do": "keys",
   "keys": "cmd-8"
  },
  {
   "expect": {
    "run.services.docker.servers.Docker.status": "Disconnected"
   }
  },
  {
   "do": "ui"
  },
  {
   "find": {
    "label": "Docker",
    "role": "AXRow"
   },
   "within": 5000
  },
  {
   "do": "click",
   "label": "Docker",
   "role": "AXRow",
   "count": 2
  },
  {
   "expect": {
    "run.services.docker.servers.Docker.status": "Connected"
   },
   "within": 8000
  },
  {
   "expect": {
    "run.services.docker.servers.Docker.containers": [
     {
      "name": "nginx-demo",
      "state": "running"
     },
     {
      "name": "redis-cache",
      "state": "exited"
     }
    ],
    "run.services.docker.servers.Docker.compose": {
     "shop": {
      "api": [
       "shop-api-1"
      ],
      "db": [
       "shop-db-1"
      ]
     }
    },
    "run.services.docker.servers.Docker.images": [
     "5555eeee0000",
     "nginx:latest",
     "postgres:16",
     "redis:7",
     "shop-api:latest"
    ],
    "run.services.docker.servers.Docker.networks": [
     "bridge",
     "host",
     "shop_default"
    ],
    "run.services.docker.servers.Docker.volumes": [
     "shop_db-data",
     "unused-data",
     "web-data"
    ]
   }
  },
  {
   "do": "click",
