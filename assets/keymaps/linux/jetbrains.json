    "context": "Dock",
    "bindings": {
      "ctrl-\"": "workspace::ToggleZoom", // IntelliJ: Maximize Tool Window
    },
  },
  {
    "context": "Editor && mode == auto_height",
    "bindings": {
      "escape": "editor::Cancel",
    },
  },
  {
    "context": "CallHierarchyPicker > Picker > Editor",
    "bindings": {
      "ctrl-k": null,
    },
  },
  {
    // IntelliJ's Search Everywhere: Tab and Shift+Tab through its tabs, over the field's and the lists' Tab
    "context": "SearchEverywhere > Input",
    "bindings": {
      "tab": "navigate::NextTab",
      "shift-tab": "navigate::PreviousTab",
    },
  },
  {
    // Complete Command on the same ⇥, ahead of Next Tab: it lets the key go on when no `/` command
    // is typed
    "context": "SearchEverywhere > Input",
    "bindings": {
      "tab": "navigate::CompleteCommand",
    },
  },
  {
    "context": "FileFinder > Picker > Editor",
    "bindings": {
      "shift-enter": "menu::SecondaryConfirm", // IntelliJ: Open in Right Split
    },
  },
  {
    "context": "VariableList",
    "bindings": {
      "f2": "variable_list::EditVariable",
      "ctrl-insert": "variable_list::CopyVariableValue",
      "ctrl-c": "variable_list::CopyVariableValue", // shown in menus over Ctrl+Insert
    },
  },
  {
    "context": "ImageViewer",
    "bindings": {
      "ctrl-/": "image_viewer::ZoomToActualSize",
    },
  },
  {
    "context": "NotebookEditor",
    "bindings": {
      "ctrl-enter": "notebook::Run",
      "ctrl-alt-shift-enter": "notebook::RunAll",
    },
  },
  {
    "context": "NotebookEditor && notebook_mode == command",
    "bindings": {
      "b": "notebook::AddCodeBlock",
      "d d": "notebook::DeleteCell",
      "delete": "notebook::DeleteCell",
      "i i": "notebook::InterruptKernel",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "alt-j": "notebook::MoveCellDown",
      "alt-k": "notebook::MoveCellUp",
    },
  },
  {
    "context": "NotebookEditor > Editor",
    "bindings": {
      "shift-enter": "notebook::RunAndAdvance",
      "ctrl-enter": "notebook::Run",
      "ctrl-alt-shift-enter": "notebook::RunAll",
      "alt-j": "notebook::MoveCellDown",
      "alt-k": "notebook::MoveCellUp",
    },
  },
  // the Welcome window (spork_projects): Open…
  { "context": "WelcomeScreen", "bindings": { "ctrl-o": "workspace::Open", "ctrl-shift-c": "projects::CopyProjectPath" } },
  {
    // IntelliJ's code intelligence (spork_code), from IntelliJ's Windows keymap, over the editing keys above
    "context": "Editor && mode == full",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-alt-l": "code::ReformatCode",
      "ctrl-alt-shift-l": "code::ReformatFile",
      "ctrl-alt-o": "code::OptimizeImports",
      "alt-insert": "code::Generate",
      "ctrl-alt-t": "code::SurroundWith",
      "ctrl-shift-down": "code::MoveStatementDown",
      "ctrl-shift-up": "code::MoveStatementUp",
      "ctrl-alt-shift-t": "code::RefactorThis",
      "shift-f6": "code::Rename",
      "ctrl-f6": "code::ChangeSignature",
      "ctrl-alt-v": "code::IntroduceVariable",
      "ctrl-alt-c": "code::IntroduceConstant",
      "ctrl-alt-m": "code::ExtractMethod",
      "ctrl-alt-n": "code::Inline",
      "ctrl-b": "code::GotoDeclaration",
      "ctrl-alt-b": "code::GotoImplementation",
      "ctrl-shift-b": "code::GotoTypeDeclaration",
      "ctrl-u": "code::GotoSuperMethod",
      "ctrl-alt-f7": "code::ShowUsages",
      "alt-f7": "code::FindUsages",
      "ctrl-shift-i": "code::QuickDefinition",
      "ctrl-alt-h": "code::CallHierarchy",
      "ctrl-h": "code::TypeHierarchy",
      "ctrl-shift-t": "code::GotoTest",
      "ctrl-alt-home": "code::GotoRelated",
      // the navigation and tool window keys of the Workspace block, over the default's editing ones
      "f12": "tool_windows::JumpToLastToolWindow",
      "shift-f12": "tool_windows::RestoreDefaultLayout",
      "ctrl-alt-down": "navigate::NextOccurrence",
      "ctrl-alt-up": "navigate::PreviousOccurrence",
      "alt-f1": "navigate::SelectIn",
      "alt-home": "navigate::JumpToNavigationBar",
      "ctrl-alt-f12": "navigate::ShowFilePath",
    },
  },
  {
    // IntelliJ's Build menu (spork_java): Build Project and Rebuild, from anywhere in the window
    "context": "Workspace",
    "bindings": {
      "ctrl-f9": "build::BuildProject",
      "ctrl-shift-f9": "build::Rebuild",
    },
  },
  {
    // IntelliJ's Override and Implement Methods (spork_java), over the default's editing keys
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-o": "java::OverrideMethods",
      "ctrl-i": "java::ImplementMethods",
    },
  },
  {
    // IntelliJ's Recompile (spork_java): the Java file in the editor, over the window's Rebuild
    "context": "Editor && extension == java",
    "bindings": {
      "ctrl-shift-f9": "build::Recompile",
    },
  },
  {
    // the Hierarchy tool window's Base on This Method (spork_code), Call Hierarchy's key
    "context": "HierarchyPanel",
    "bindings": {
      "ctrl-alt-h": "code::CallHierarchy",
    },
  },
  {
    // IntelliJ's Markdown styling keys, over the code keys above in Markdown files
    "context": "Editor && extension == md",
    "bindings": {
      "ctrl-b": "spork_editor::ToggleBold",
      "ctrl-i": "spork_editor::ToggleItalic",
      "ctrl-shift-s": "spork_editor::ToggleStrikethrough",
      "ctrl-shift-c": "spork_editor::ToggleCodeSpan",
      "ctrl-shift-u": "spork_editor::CreateLink",
      "ctrl-u": "spork_editor::InsertImage", // over Go to Super Method
    },
  },
]
