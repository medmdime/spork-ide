{
 "id": "kotlin-maven-debug",
 "fixture": "kotlin-maven",
 "covers": [],
 "settings": {
  "languages": {
   "Kotlin": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "sh": "mkdir -p .zed && printf '[{\"label\": \"MainKt\", \"adapter\": \"Kotlin\", \"request\": \"launch\", \"mainClass\": \"com.example.MainKt\"}]' > .zed/debug.json"
  },
  {
   "expect": {
    "java.tool": "Maven",
    "kotlin.detected": true
   },
   "within": 20000
  },
  {
   "expect": {
    "java.linked": true,
    "kotlin.server.running": true
   },
   "within": 600000
  },
  {
   "expect": {
    "kotlin.server.busy": false
   },
   "within": 300000
  },
  {
   "expect": {
    "run.configurations.names": [
     "MainKt"
    ],
    "run.configurations.selected": "MainKt"
   },
   "within": 10000
  },
  {
   "do": "open",
   "path": "src/main/kotlin/com/example/Greeting.kt"
  },
  {
   "expect": {
    "active": "src/main/kotlin/com/example/Greeting.kt"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "6:9"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints.0.at": "Greeting.kt:6"
   }
  },
  {
   "find": {
    "label": "Debug 'MainKt'",
    "role": "AXButton",
    "enabled": true
   },
   "within": 10000
  },
  {
   "do": "keys",
   "keys": "ctrl-d"
  },
  {
   "expect": {
    "docks.bottom.open": true,
    "docks.bottom.panel": "DebugPanel",
    "run.debug.status": "Stopped"
   },
   "within": 180000
  },
  {
   "find": {
    "label": "text:6, Greeting (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "do": "click",
   "label": "Evaluate expression (⏎) or add a watch (⇧⌘⏎)",
   "role": "AXTextField"
  },
  {
   "do": "type",
   "text": "if (name == \"world\") 1 else 2"
  },
  {
   "do": "keys",
   "keys": "shift-cmd-enter"
  },
  {
   "expect": {
    "run.debug.watches": {
     "if (name == \"world\") 1 else 2": "1"
    }
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "shift-f8"
  },
  {
   "find": {
    "label": "greet:14, MainKt (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "do": "keys",
   "keys": "alt-cmd-r"
  },
  {
   "find": {
    "label": "text:6, Greeting (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "expect": {
    "run.debug.watches": {
     "if (name == \"world\") 1 else 2": "2"
    }
   },
   "within": 20000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}
