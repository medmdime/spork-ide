{
 "id": "history-diff-file-history",
 "covers": [
  "toolbar:Vcs.FileHistory.Toolbar",
  "context-menu:Vcs.FileHistory.Toolbar",
  "toolbar:Vcs.FileHistory.Toolbar.RightCorner",
  "context-menu:Vcs.FileHistory.Toolbar.RightCorner",
  "toolbar:VcsHistoryActionsGroup.Toolbar",
  "context-menu:VcsHistoryActionsGroup.Toolbar",
  "context-menu:Vcs.FileHistory.ContextMenu",
  "context-menu:Dvcs.FileHistory.ContextMenu",
  "context-menu:Git.FileHistory.ContextMenu",
  "context-menu:VcsHistoryActionsGroup",
  "context-menu:Vcs.FileHistory.PresentationSettings",
  "action:Vcs.RefreshFileHistory",
  "action:FileHistory.AnnotateRevision"
 ],
 "reference-app": [
  "screenshots/menus/vcs-filehistory-toolbar.png",
  "screenshots/menus/vcs-filehistory-toolbar-rightcorner.png",
  "screenshots/menus/vcs-filehistory-contextmenu.png",
  "screenshots/menus/vcs-filehistory-presentationsettings.png"
 ],
 "steps": [
  {"do": "open", "what": "file-history", "path": "README.md"},
  {"expect": {"view": "File", "mode": "history", "revisions": ["docs: a second line", "docs: start the readme"], "selected": "docs: a second line", "loads": 1}, "of": {"do": "history"}},
  {"toolbar": "Vcs.FileHistory.Toolbar", "items": ["Refresh", "Show Diff", "Show All Affected Files", "View Options"]},
  {"toolbar": "Vcs.FileHistory.Toolbar.RightCorner", "items": ["Show in VCS Log"]},
  {"wait": 600},
  {"shot": "history"},
  {"do": "click", "label": "docs: start the readme"},
  {"wait": 500},
  {"expect": {"selected": "docs: start the readme"}, "of": {"do": "history"}},
  {"do": "keys", "keys": "cmd-r"},
  {"expect": {"loads": 2, "selected": "docs: start the readme"}, "of": {"do": "history"}},
  {"do": "click", "label": "docs: a second line", "button": "right"},
  {"wait": 500},
  {"menu": "context-menu:Vcs.FileHistory.ContextMenu", "items": ["Copy Revision Number", "Create Patch…", "Cherry-Pick", "Get", "Show File at Revision", "Compare with Local", "Show Diff", "Show Diff in a New Tab or Window", "Show All Affected Files", "Annotate", "Show in VCS Log", "Revert Commit", "Fixup…", "Squash Into…", "New Tag…"]},
  {"expect": {"selected": "docs: a second line"}, "of": {"do": "history"}},
  {"shot": "revision-menu"},
  {"do": "click", "label": "Compare with Local", "role": "AXMenuItem"},
  {"wait": 500},
  {"expect": {"comparison": "1cf6d44 vs Local"}, "of": {"do": "history"}},
  {"do": "click", "label": "View Options"},
  {"wait": 500},
  {"menu": "context-menu:Vcs.FileHistory.PresentationSettings", "items": ["Commit Timestamp", "Columns", "Show Details", "Show Diff Preview", "Diff Preview Location"]},
  {"do": "click", "label": "Show Diff Preview", "role": "AXMenuItem"},
  {"wait": 500},
  {"expect": {"diff_preview": false}, "of": {"do": "history"}},
  {"do": "click", "label": "View Options"},
  {"wait": 500},
  {"do": "click", "label": "Diff Preview Location", "role": "AXMenuItem"},
  {"wait": 500},
  {"menu": "context-menu:Vcs.Log.Diff.Preview.Location", "items": ["Bottom", "Right"]},
  {"do": "click", "label": "Bottom", "role": "AXMenuItem"},
  {"wait": 500},
  {"expect": {"diff_preview_location": "Bottom"}, "of": {"do": "history"}},
  {"do": "click", "label": "docs: start the readme", "button": "right"},
  {"wait": 500},
  {"do": "click", "label": "Annotate", "role": "AXMenuItem"},
  {"wait": 500},
  {"expect": {"mode": "annotate", "annotated_at": "docs: start the readme", "annotated_lines": 1}, "of": {"do": "history"}}
 ]
}
