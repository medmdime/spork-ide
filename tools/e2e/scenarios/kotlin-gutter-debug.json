{
 "id": "kotlin-gutter-debug",
 "fixture": "kotlin-gradle",
 "covers": [],
 "settings": {
  "languages": {
   "Kotlin": {
    "enable_language_server": true
   }
  }
 },
 "steps": [
  {
   "expect": {
    "java.tool": "Gradle",
    "kotlin.detected": true
   },
   "within": 20000
  },
  {
   "do": "action",
   "name": "workspace::ToggleLeftDock"
  },
  {
   "expect": {
    "java.linked": true,
    "kotlin.server.running": true
   },
   "within": 600000
  },
  {
   "expect": {
    "kotlin.server.busy": false
   },
   "within": 300000
  },
  {
   "do": "open",
   "path": "src/main/kotlin/com/example/Main.kt"
  },
  {
   "expect": {
    "active": "src/main/kotlin/com/example/Main.kt"
   },
   "within": 5000
  },
  {
   "do": "keys",
   "keys": "cmd-l"
  },
  {
   "wait": 500
  },
  {
   "do": "type",
   "text": "13:9"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "wait": 300
  },
  {
   "do": "keys",
   "keys": "cmd-f8"
  },
  {
   "expect": {
    "run.breakpoints.0.at": "Main.kt:13"
   },
   "within": 5000
  },
  {
   "wait": 1500
  },
  {
   "do": "click",
   "at": [
    76,
    136
   ]
  },
  {
   "wait": 1500
  },
  {
   "wait": 500
  },
  {
   "do": "activate"
  },
  {
   "shot": "popup"
  },
  {
   "do": "keys",
   "keys": "down"
  },
  {
   "do": "keys",
   "keys": "enter"
  },
  {
   "expect": {
    "docks.bottom.open": true,
    "docks.bottom.panel": "DebugPanel",
    "run.debug.status": "Stopped"
   },
   "within": 180000
  },
  {
   "find": {
    "label": "greet:13, MainKt (com.example)",
    "selected": true
   },
   "within": 20000
  },
  {
   "expect": {
    "active": "src/main/kotlin/com/example/Main.kt"
   }
  },
  {
   "do": "keys",
   "keys": "f9"
  },
  {
   "find": {
    "label": "greet:13, MainKt (com.example)",
    "selected": true
   },
   "within": 30000
  },
  {
   "do": "keys",
   "keys": "cmd-f2"
  },
  {
   "expect": {
    "run.debug.terminated": true
   },
   "within": 30000
  }
 ]
}