  {
   "do": "keys",
   "keys": "cmd-home down right right"
  },
  {
   "do": "keys",
   "keys": "cmd-b"
  },
  {
   "expect": {
    "active": {
     "contains": "ServerProperties.java"
    }
   },
   "within": 15000
  },
  {
   "sh": "find \"../home/Library/Application Support/Spork IDE/java/sources\" -name ServerProperties.java | wc -l | tr -d ' '",
   "is": "1"
  }
 ]
}
