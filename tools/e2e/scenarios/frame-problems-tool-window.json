{
 "id": "frame-problems-tool-window",
 "covers": [
  "action:ActivateProblemsViewToolWindow"
 ],
 "settings": {
  "enable_language_server": true,
  "lsp": {
   "rust-analyzer": {
    "binary": {
     "path": "$RUST_ANALYZER"
    },
    "initialization_options": {
     "checkOnSave": false,
     "cargo": {
      "buildScripts": {
       "enable": false
      }
     },
     "procMacro": {
      "enable": false
     }
    }
   }
  }
 },
 "steps": [
  {
   "file": "src/greeting.rs",
   "text": "pub fn hello(name: &str) -> String {\n    let count: i32 = \"one\";\n    format!(\"Hello, {name}!\")\n}\n"
  },
  {
   "do": "open",
   "path": "src/greeting.rs"
  },
  {
   "expect": {
    "active": "src/greeting.rs",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-6"
  },
  {
   "expect": {
    "docks.bottom.open": true,
    "docks.bottom.panel": "Problems",
    "focused": [
     "Workspace",
     "Dock",
     "ProblemsPanel"
    ]
   }
  },
  {
   "find": [
    {
     "label": "File",
     "role": "AXRadioButton"
    },
    {
     "label": "Project Errors",
     "role": "AXRadioButton"
    }
   ]
  },
  {
   "toolbar": "Problems Toolbar",
   "items": [
    "View Options",
    "Show Quick-Fixes (disabled)",
    "Open Editor Preview",
    "Expand All",
    "Collapse All"
   ],
   "within": 60000
  },
  {
   "find": [
    {
     "label": "greeting.rs",
     "role": "AXRow",
     "in": "Problems"
    },
    {
     "label": "expected i32, found &'static str",
     "role": "AXRow",
     "in": "Problems"
    }
   ],
   "ordered": true,
   "within": 60000
  },
  {
   "do": "click",
   "at": [
    700,
    300
   ],
   "hover": true
  },
  {
   "shot": "file-tab"
  },
  {
   "do": "click",
   "label": "Collapse All",
   "in": "Problems Toolbar"
  },
  {
   "find": {
    "label": "expected i32, found &'static str",
    "role": "AXRow",
    "in": "Problems"
   },
   "absent": true
  },
  {
   "do": "click",
   "label": "Expand All",
   "in": "Problems Toolbar"
  },
  {
   "do": "click",
   "label": "expected i32, found &'static str",
   "role": "AXRow",
   "in": "Problems"
  },
  {
   "toolbar": "Problems Toolbar",
   "items": [
    "View Options",
    "Show Quick-Fixes",
    "Open Editor Preview",
    "Expand All",
    "Collapse All"
   ]
  },
  {
   "do": "click",
   "label": "expected i32, found &'static str",
   "role": "AXRow",
   "in": "Problems",
   "count": 2
  },
  {
   "expect": {
    "active": "src/greeting.rs",
    "focused": [
     "Workspace",
     "Pane",
     "Editor"
    ]
   }
  },
  {
   "do": "open",
   "path": "src/main.rs"
  },
  {
   "find": {
    "text": "No problems in main.rs"
   },
   "within": 5000
  },
  {
   "do": "click",
   "label": "Project Errors",
   "role": "AXRadioButton"
  },
  {
   "find": [
    {
     "label": "greeting.rs",
     "role": "AXRow",
     "in": "Problems"
    },
    {
     "label": "expected i32, found &'static str",
     "role": "AXRow",
     "in": "Problems"
    }
   ],
   "ordered": true
  },
  {
   "expect": {
    "focused": [
     "Workspace",
     "Dock",
     "ProblemsPanel"
    ]
   }
  },
  {
   "do": "keys",
   "keys": "cmd-6"
  },
  {
   "expect": {
    "docks.bottom.open": false
   }
  }
 ]
}
