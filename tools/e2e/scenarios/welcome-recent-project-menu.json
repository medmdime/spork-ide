   "window": "Welcome to Spork IDE"
  },
  {
   "sh": "pbpaste",
   "is": "$FIXTURE"
  },
  {
   "do": "click",
   "label": "More Actions",
   "role": "AXButton"
  },
  {
   "do": "click",
   "label": "Open Selected"
  },
  {
   "expect": {
    "roots": [
     "$FIXTURE"
    ]
   },
   "within": 15000
  }
 ]
